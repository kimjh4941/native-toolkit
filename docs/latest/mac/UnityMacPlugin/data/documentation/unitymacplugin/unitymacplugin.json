ading","text":"Architecture"},{"inlineContent":[{"type":"codeVoice","code":"UnityMacDialogManager"},{"type":"text","text":" wraps "},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"type":"text","text":" and converts strongly typed Swift "},{"type":"codeVoice","code":"Result"},{"text":" ","type":"text"},{"text":"completions into Objective‑C friendly ","type":"text"},{"type":"codeVoice","code":"(NSDictionary?, NSError?)"},{"type":"text","text":" callbacks. The C bridge functions"},{"text":" ","type":"text"},{"type":"text","text":"(defined in "},{"type":"emphasis","inlineContent":[{"text":"UnityMacDialogManagerBridge.h \/ .m","type":"text"}]},{"text":") further flatten those into plain C primitives so they can be","type":"text"},{"text":" ","type":"text"},{"text":"consumed with P\/Invoke (","type":"text"},{"code":"[DllImport(\"__Internal\")]","type":"codeVoice"},{"text":") from Unity C# code. A managed helper (","type":"text"},{"type":"codeVoice","code":"MacDialogManager"},{"text":" C# MonoBehaviour)","type":"text"},{"text":" ","type":"text"},{"text":"exposes idiomatic events, performs marshaling, and handles memory cleanup.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Layering:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["Unity C# (MacDialogManager.cs)","   ↓ (P\/Invoke \/ DllImport)","C Bridge (UnityMacDialogManagerBridge.*)","   ↓ (Objective‑C → Swift)","UnityMacDialogManager (Swift facade)","   ↓","MacDialogManager (Core logic)","   ↓","AppKit (NSAlert \/ NSOpenPanel \/ NSSavePanel)"],"syntax":null},{"level":3,"text":"Result Dictionaries","anchor":"Result-Dictionaries","type":"heading"},{"inlineContent":[{"text":"Each dialog type returns a dictionary with well‑defined keys (all values are Foundation bridged types):","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Dialog Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keys"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alert"}]}],[{"inlineContent":[{"type":"codeVoice","code":"buttonTitle:String"},{"type":"text","text":", "},{"type":"codeVoice","code":"buttonIndex:Int"},{"text":", ","type":"text"},{"type":"codeVoice","code":"suppressionButtonState:Bool"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"File \/ MultiFile \/ Folder \/ MultiFolder","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"filePaths:[String]"},{"type":"text","text":", "},{"type":"codeVoice","code":"fileCount:Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"directoryURL:String"},{"type":"text","text":", "},{"code":"isCancelled:Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess:Bool","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Save","type":"text"}]}],[{"inlineContent":[{"type":"codeVoice","code":"filePath:String"},{"text":", ","type":"text"},{"code":"fileCount:Int","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"directoryURL:String"},{"text":", ","type":"text"},{"type":"codeVoice","code":"isCancelled:Bool"},{"type":"text","text":", "},{"code":"isSuccess:Bool","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"Error cases provide an ","type":"text"},{"code":"NSError","type":"codeVoice"},{"text":" whose ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" mirrors "},{"type":"codeVoice","code":"MacLibrary\/DialogError"},{"type":"text","text":" text."}],"type":"paragraph"},{"anchor":"Cancellation-Semantics","level":3,"type":"heading","text":"Cancellation Semantics"},{"inlineContent":[{"type":"text","text":"Cancellation is reported as "},{"code":"isCancelled == true","type":"codeVoice"},{"type":"text","text":" while still treating the operation as logically successful ("},{"type":"codeVoice","code":"isSuccess == true"},{"type":"text","text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set "},{"type":"codeVoice","code":"isSuccess == false"},{"text":" and provide an ","type":"text"},{"code":"NSError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Alert JSON Schema","type":"heading","level":3,"anchor":"Alert-JSON-Schema"},{"type":"paragraph","inlineContent":[{"code":"buttonsJson","type":"codeVoice"},{"type":"text","text":" example:"}]},{"code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"codeVoice","code":"optionsJson"},{"type":"text","text":" example:"}],"type":"paragraph"},{"code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"code":"alertStyle","type":"codeVoice"},{"text":" accepts: ","type":"text"},{"code":"informational","type":"codeVoice"},{"text":" | ","type":"text"},{"code":"warning","type":"codeVoice"},{"text":" | ","type":"text"},{"type":"codeVoice","code":"critical"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"File & Folder Selection","anchor":"File--Folder-Selection","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"File filters are passed as an array of filename extensions (no leading dot) and converted to "},{"type":"codeVoice","code":"UTType"},{"type":"text","text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly."}],"type":"paragraph"},{"text":"Save Panel","type":"heading","level":3,"anchor":"Save-Panel"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The save dialog returns a single path. "},{"code":"fileCount","type":"codeVoice"},{"type":"text","text":" remains for structural symmetry (1 on success, 0 if cancelled)."}]},{"text":"Threading","type":"heading","level":3,"anchor":"Threading"},{"type":"paragraph","inlineContent":[{"text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events.","type":"text"}]},{"text":"Memory & Lifetime Notes","type":"heading","level":3,"anchor":"Memory--Lifetime-Notes"},{"type":"paragraph","inlineContent":[{"text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them (","type":"text"},{"code":"Marshal.PtrToStringUTF8","type":"codeVoice"},{"type":"text","text":") into managed strings immediately. Caller code only receives safe managed data."}]},{"type":"thematicBreak"},{"anchor":"Unity-C-Wrapper-MacDialogManagercs","type":"heading","level":2,"text":"Unity C# Wrapper (MacDialogManager.cs)"},{"type":"paragraph","inlineContent":[{"text":"The provided sample ","type":"text"},{"type":"codeVoice","code":"MacDialogManager"},{"type":"text","text":" MonoBehaviour offers:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lazy singleton creation ("},{"type":"codeVoice","code":"Instance"},{"type":"text","text":" property); object is marked "},{"type":"codeVoice","code":"DontDestroyOnLoad"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Event-based result delivery for each dialog type:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MultiFileDialogResult(…)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FolderDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MultiFolderDialogResult(…)"}]}]},{"content":[{"inlineContent":[{"code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Validation (title, buttons\/options presence) with early error event emission.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Main‑thread dispatch for all event invocations.","type":"text"}]}]}]},{"anchor":"C-Alert-Usage","type":"heading","level":3,"text":"C# Alert Usage"},{"syntax":"csharp","type":"codeListing","code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (success) Debug.Log($\"Pressed {title} (index {index}) suppression={suppression}\");","    else Debug.LogError(err);","};","MacDialogManager.Instance.ShowDialog(\"Example\", \"Choose an option\", buttons, options);"]},{"anchor":"C-Single-File-Dialog","level":3,"type":"heading","text":"C# Single File Dialog"},{"code":["MacDialogManager.Instance.FileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (!success) { Debug.LogError(err); return; }","    if (cancelled) Debug.Log(\"User cancelled\"); else Debug.Log(string.Join(\"\\n\", paths));","};","MacDialogManager.Instance.ShowFileDialog(\"Select File\", \"Pick a single file\", new [] { \"txt\", \"md\" });"],"syntax":"csharp","type":"codeListing"},{"anchor":"C-Multi-File-Dialog","level":3,"type":"heading","text":"C# Multi File Dialog"},{"code":["MacDialogManager.Instance.MultiFileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Selected {count} files\");","};","MacDialogManager.Instance.ShowMultiFileDialog(\"Select Files\", \"Choose multiple\", new [] { \"png\", \"jpg\" });"],"syntax":"csharp","type":"codeListing"},{"anchor":"C-Folder--Multi-Folder","level":3,"type":"heading","text":"C# Folder & Multi Folder"},{"code":["MacDialogManager.Instance.FolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folder: {paths?[0]}\");","};","MacDialogManager.Instance.ShowFolderDialog(\"Select Folder\", \"Choose a folder\");","","MacDialogManager.Instance.MultiFolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folders: {string.Join(\", \", paths ?? Array.Empty<string>())}\");","};","MacDialogManager.Instance.ShowMultiFolderDialog(\"Select Folders\", \"Choose multiple folders\");"],"syntax":"csharp","type":"codeListing"},{"anchor":"C-Save-File-Dialog","level":3,"type":"heading","text":"C# Save File Dialog"},{"code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"],"syntax":"csharp","type":"codeListing"},{"text":"Events Lifecycle Notes","anchor":"Events-Lifecycle-Notes","type":"heading","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Subscribe ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"text":" invoking the corresponding ","type":"text"},{"type":"codeVoice","code":"Show*"},{"text":" method to avoid race conditions if a dialog closes quickly (rare but possible).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Unsubscribe when no longer needed to avoid memory leaks in long‑running editor sessions.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Multiple listeners are supported; each is invoked sequentially."}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"text":"C Bridge Mapping","anchor":"C-Bridge-Mapping","type":"heading","level":2},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"C Function"}]}],[{"type":"paragraph","inlineContent":[{"text":"C# DllImport Signature (Simplified)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Managed Invoke Method"}]}],[{"inlineContent":[{"type":"text","text":"Result Event"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"showDialog"}],"type":"paragraph"}],[{"inlineContent":[{"code":"void showDialog(string,string,string,string,DialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"AlertDialogResult"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"showFileDialog"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"void showFileDialog(string,string,IntPtr,int,string,FileDialogCallback)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowFileDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"FileDialogResult","type":"codeVoice"}],"type":"paragraph"}]],[[{"
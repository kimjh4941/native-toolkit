s"},{"text":" element is marshalled as an individual unmanaged UTF‑8 buffer + NULL terminator.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A contiguous pointer array is allocated and passed to the C bridge."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cleanup occurs inside the callback’s "},{"type":"codeVoice","code":"finally"},{"type":"text","text":" block after the Unity main thread event dispatch, ensuring no premature free."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"On exceptions during setup, allocated buffers are freed before emitting an error event.","type":"text"}]}]}]},{"type":"heading","anchor":"Error-Patterns","level":3,"text":"Error Patterns"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Condition","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Emitted Event Values"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Notes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Empty title","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"buttonIndex \/ fileCount = -1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=false","type":"codeVoice"},{"text":", error message populated","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Validation short‑circuit"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"No buttons (alert)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"buttonIndex = -1"},{"type":"text","text":", "},{"code":"isSuccess=false","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"DialogError.noButtons","type":"codeVoice"},{"text":" equivalent","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"User cancel (panel)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"isCancelled=true"},{"text":", ","type":"text"},{
chor":"Memory-Safety-in-C-Wrapper","level":3,"type":"heading","text":"Memory Safety in C# Wrapper"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"string[] allowedContentTypes"},{"type":"text","text":" element is marshalled as an individual unmanaged UTF‑8 buffer + NULL terminator."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A contiguous pointer array is allocated and passed to the C bridge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cleanup occurs inside the callback’s ","type":"text"},{"type":"codeVoice","code":"finally"},{"text":" block after the Unity main thread event dispatch, ensuring no premature free.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"On exceptions during setup, allocated buffers are freed before emitting an error event.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Error-Patterns","level":3,"text":"Error Patterns","type":"heading"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Condition","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Emitted Event Values","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Notes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Empty title"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"buttonIndex \/ fileCount = -1"},{"text":", ","type":"text"},{"type":"codeVoice","code":"isSuccess=false"},{"text":", error message populated","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Validation short‑circuit"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"No buttons (alert)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"buttonIndex = -1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=false","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DialogError.noBut
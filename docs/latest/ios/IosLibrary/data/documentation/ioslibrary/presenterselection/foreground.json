ettled.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"On an iPad with two of the app’s scenes side by side, both scenes can be","type":"text"},{"text":" ","type":"text"},{"code":"foregroundActive","type":"codeVoice"},{"text":" with a key window each, so the scene this chooses may not be the one","type":"text"},{"text":" ","type":"text"},{"text":"the user is looking at. Pass the view controller with ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/viewController(_:)","type":"reference","isActive":true},{"text":" there.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"}],"kind":"content"}],"abstract":[{"text":"The topmost view controller in the foreground: of the key window of a ","type":"text"},{"type":"codeVoice","code":"foregroundActive"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"codeVoice","code":"foregroundInactive"},{"text":" window scene, following the presented view controllers that are","type":"text"},{"text":" ","type":"text"},{"text":"not being dismissed.","type":"text"}],"identifier":{"url":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/foreground","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://com.jonghyunkim.nativetoolkit.IosLibrary/documentation/IosLibrary/PresenterSelection/viewController(_:)":{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/viewController(_:)","role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"viewController"},{"kind":"text","text":"(@"},{"kind":"typeIdentifier","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" () -> "},{"
],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"PresenterSelection","kind":"identifier"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass one to the operations that present a dialog or a share sheet, or that may show a system"},{"type":"text","text":" "},{"type":"text","text":"prompt (requesting the notification permission, opening the notification settings)."}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"View controller"}]}],[{"type":"paragraph","inlineContent":[{"text":"Checks before presenting","type":"text"}]}]],[[{"inlineContent":[{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/firstActiveScene","type":"reference","isActive":true},{"text":" (default)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The topmost presented view controller of the key window of the first ","type":"text"},{"code":"foregroundActive","type":"codeVoice"},{"text":" window scene","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Searched once, no waiting: the behavior of each operation before this type existed. A dialog is presented whatever the state of that view controller; a share sheet fails at once when that view controller is being presented or dismissed, is presenting something, or is itself a share sheet, or while a share sheet of this library is still appearing in its window","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/foreground","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"The topmost presented view controller that is not being dismissed, of the key window of a ","type":"text"},{"code":"foregroundActive","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":"foregroundInactive"},{"type":"text","text":" window scene"}]}],[{"type":"paragraph","inlineContent":[{"text":"When none is found the operation fails as not in the foreground. When that view controller is in a transition, the operation waits once for the transition to end and checks again; it fails when it is still not settled","type":"text"}]}]],[[{"inlineContent":[{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/viewController(_:)","type":"reference","isActive":true}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"The one the closure returns, called once on the main thread","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When the closure returns "},{"code":"nil","type":"codeVoice"},{"text":", the operation fails as not in the foreground. Otherwise the same single wait as ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/foreground","type":"reference","isActive":true}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"With "},{"type":"reference","identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/foreground","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/viewController(_:)","type":"reference","isActive":true},{"type":"text","text":", a share sheet of this library that is still"},{"type":"text","text":" "},{"type":"text","text":"appearing in the same window counts as not settled: a dialog or a share sheet waits for it (this is"},{"text":" ","type":"text"},{"text":"the single wait), and fails when it has not finished appearing within 10 seconds. A share sheet","type":"text"},{"text":" ","type":"text"},{"text":"is never presented on a share sheet: a share fails when the view controller found is one,","type":"text"},{"text":" ","type":"text"},{"text":"whatever the value.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An operation that does not present a view controller itself but may show a system prompt","type":"text"},{"text":" ","type":"text"},{"text":"(requesting the notification permission, opening the settings) only checks that the app is","type":"text"},{"text":" ","type":"text"},{"text":"in the foreground: ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/firstActiveScene","type":"reference","isActive":true},{"text":" checks nothing, ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/foreground","type":"reference","isActive":true},{"text":" needs a view","type":"text"},{"text":" ","type":"text"},{"text":"controller as above but does not wait for it to settle, and ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/viewController(_:)","type":"reference","isActive":true},{"text":" needs the","type":"text"},{"text":" ","type":"text"},{"text":"returned view controller to be in a window.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The dialog manager’s ","type":"text"},{"code":"show(_:presenter:requestBox:completion:)","type":"codeVoice"},{"text":", the share manager’s","type":"text"},{"text":" ","type":"text"},{"code":"share(content:presenter:completion:)","type":"codeVoice"},{"text":" and the notification manager’s","type":"text"},{"text":" ","type":"text"},{"code":"requestPermission(options:presenter:completion:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"openNotificationSettings(presenter:completion:)","type":"codeVoice"},{"text":" take one (and their ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" forms).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"foregroundInactive","type":"codeVoice"},{"text":" covers the moments when the app is visible but not active: right after","type":"text"},{"text":" ","type":"text"},{"text":"launch, and while Control Center or Notification Center is pulled over the app.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The type is a struct with static members, so that a value reads like an enum case at the call","type":"text"},{"text":" ","type":"text"},{"text":"site (","type":"text"},{"code":"presenter: .foreground","type":"codeVoice"},{"text":") and later values can be added without breaking a ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Values cannot be compared, because one of them holds a closure.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Threading","anchor":"Threading","type":"heading"},{"inlineContent":[{"code":"PresenterSelection","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":", so it can be passed to the operations from any thread.","type":"text"},{"text":" ","type":"text"},{"text":"The closure of ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/viewController(_:)","type":"reference","isActive":true},{"text":" always runs on the main thread.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://com.jonghyunkim.nativetoolkit.IosLibrary/documentation/IosLibrary/PresenterSelection/firstActiveScene":{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection\/fir
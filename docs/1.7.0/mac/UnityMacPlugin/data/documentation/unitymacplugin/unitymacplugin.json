{"hierarchy":{"paths":[["doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin"]]},"sections":[],"identifier":{"url":"doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin\/UnityMacPlugin","interfaceLanguage":"swift"},"kind":"article","abstract":[{"type":"text","text":"High‑level Unity bridge for macOS dialog presentation built on top of "},{"type":"codeVoice","code":"MacLibrary"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"UnityMacPlugin","type":"codeVoice"},{"text":" exposes the dialog and file panel functionality implemented in the Swift","type":"text"},{"text":" ","type":"text"},{"code":"MacLibrary\/MacDialogManager","type":"codeVoice"},{"text":" to Unity (C#) or other native layers through a thin","type":"text"},{"text":" ","type":"text"},{"text":"Objective‑C \/ C bridge. It handles:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Alert dialogs ("},{"code":"UnityMacDialogManager\/showDialog(title:message:buttonsJson:optionsJson:completion:)","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Single & multi file pickers (open panels)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Single & multi folder pickers"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Save file dialogs"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Suppression checkbox state reporting"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"JSON → Swift option translation for alert configuration"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Safe marshaling of results back to Unity via C function callbacks"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Architecture","type":"heading","anchor":"Architecture"},{"type":"paragraph","inlineContent":[{"code":"UnityMacDialogManager","type":"codeVoice"},{"text":" wraps ","type":"text"},{"code":"MacLibrary\/MacDialogManager","type":"codeVoice"},{"text":" and converts strongly typed Swift ","type":"text"},{"code":"Result","type":"codeVoice"},{"text":" ","type":"text"},{"text":"completions into Objective‑C friendly ","type":"text"},{"code":"(NSDictionary?, NSError?)","type":"codeVoice"},{"text":" callbacks. The C bridge functions","type":"text"},{"text":" ","type":"text"},{"text":"(defined in ","type":"text"},{"inlineContent":[{"text":"UnityMacDialogManagerBridge.h \/ .m","type":"text"}],"type":"emphasis"},{"text":") further flatten those into plain C primitives so they can be","type":"text"},{"text":" ","type":"text"},{"text":"consumed with P\/Invoke (","type":"text"},{"code":"[DllImport(\"__Internal\")]","type":"codeVoice"},{"text":") from Unity C# code. A managed helper (","type":"text"},{"code":"MacDialogManager","type":"codeVoice"},{"text":" C# MonoBehaviour)","type":"text"},{"text":" ","type":"text"},{"text":"exposes idiomatic events, performs marshaling, and handles memory cleanup.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Layering:","type":"text"}]},{"code":["Unity C# (MacDialogManager.cs)","   ↓ (P\/Invoke \/ DllImport)","C Bridge (UnityMacDialogManagerBridge.*)","   ↓ (Objective‑C → Swift)","UnityMacDialogManager (Swift facade)","   ↓","MacDialogManager (Core logic)","   ↓","AppKit (NSAlert \/ NSOpenPanel \/ NSSavePanel)"],"type":"codeListing","syntax":null},{"level":3,"text":"Result Dictionaries","type":"heading","anchor":"Result-Dictionaries"},{"type":"paragraph","inlineContent":[{"text":"Each dialog type returns a dictionary with well‑defined keys (all values are Foundation bridged types):","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Dialog Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alert"}]}],[{"type":"paragraph","inlineContent":[{"code":"buttonTitle:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"buttonIndex:Int","type":"codeVoice"},{"type":"text","text":", "},{"code":"suppressionButtonState:Bool","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"File \/ MultiFile \/ Folder \/ MultiFolder","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"filePaths:[String]","type":"codeVoice"},{"type":"text","text":", "},{"code":"fileCount:Int","type":"codeVoice"},{"type":"text","text":", "},{"code":"directoryURL:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isCancelled:Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess:Bool","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Save","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"filePath:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fileCount:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"directoryURL:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isCancelled:Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess:Bool","type":"codeVoice"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Error cases provide an "},{"code":"NSError","type":"codeVoice"},{"type":"text","text":" whose "},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" mirrors "},{"code":"MacLibrary\/DialogError","type":"codeVoice"},{"type":"text","text":" text."}]},{"level":3,"text":"Cancellation Semantics","type":"heading","anchor":"Cancellation-Semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation is reported as "},{"code":"isCancelled == true","type":"codeVoice"},{"type":"text","text":" while still treating the operation as logically successful ("},{"code":"isSuccess == true","type":"codeVoice"},{"type":"text","text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set "},{"code":"isSuccess == false","type":"codeVoice"},{"type":"text","text":" and provide an "},{"code":"NSError","type":"codeVoice"},{"type":"text","text":"."}]},{"level":3,"text":"Alert JSON Schema","type":"heading","anchor":"Alert-JSON-Schema"},{"type":"paragraph","inlineContent":[{"code":"buttonsJson","type":"codeVoice"},{"type":"text","text":" example:"}]},{"code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"code":"optionsJson","type":"codeVoice"},{"type":"text","text":" example:"}]},{"code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"code":"alertStyle","type":"codeVoice"},{"type":"text","text":" accepts: "},{"code":"informational","type":"codeVoice"},{"type":"text","text":" | "},{"code":"warning","type":"codeVoice"},{"type":"text","text":" | "},{"code":"critical","type":"codeVoice"},{"type":"text","text":"."}]},{"level":3,"text":"File & Folder Selection","type":"heading","anchor":"File--Folder-Selection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"File filters are passed as an array of filename extensions (no leading dot) and converted to "},{"code":"UTType","type":"codeVoice"},{"type":"text","text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly."}]},{"level":3,"text":"Save Panel","type":"heading","anchor":"Save-Panel"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The save dialog returns a single path. "},{"code":"fileCount","type":"codeVoice"},{"type":"text","text":" remains for structural symmetry (1 on success, 0 if cancelled)."}]},{"level":3,"text":"Threading","type":"heading","anchor":"Threading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events."}]},{"level":3,"text":"Memory & Lifetime Notes","type":"heading","anchor":"Memory--Lifetime-Notes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them ("},{"code":"Marshal.PtrToStringUTF8","type":"codeVoice"},{"type":"text","text":") into managed strings immediately. Caller code only receives safe managed data."}]},{"type":"thematicBreak"},{"level":2,"text":"Unity C# Wrapper (MacDialogManager.cs)","type":"heading","anchor":"Unity-C-Wrapper-MacDialogManagercs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The provided sample "},{"code":"MacDialogManager","type":"codeVoice"},{"type":"text","text":" MonoBehaviour offers:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Lazy singleton creation ("},{"code":"Instance","type":"codeVoice"},{"type":"text","text":" property); object is marked "},{"code":"DontDestroyOnLoad","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Event-based result delivery for each dialog type:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MultiFileDialogResult(…)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FolderDialogResult(…)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MultiFolderDialogResult(…)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"type":"text","text":"Validation (title, buttons\/options presence) with early error event emission."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Main‑thread dispatch for all event invocations."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"C# Alert Usage","type":"heading","anchor":"C-Alert-Usage"},{"code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (success) Debug.Log($\"Pressed {title} (index {index}) suppression={suppression}\");","    else Debug.LogError(err);","};","MacDialogManager.Instance.ShowDialog(\"Example\", \"Choose an option\", buttons, options);"],"type":"codeListing","syntax":"csharp"},{"level":3,"text":"C# Single File Dialog","type":"heading","anchor":"C-Single-File-Dialog"},{"code":["MacDialogManager.Instance.FileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (!success) { Debug.LogError(err); return; }","    if (cancelled) Debug.Log(\"User cancelled\"); else Debug.Log(string.Join(\"\\n\", paths));","};","MacDialogManager.Instance.ShowFileDialog(\"Select File\", \"Pick a single file\", new [] { \"txt\", \"md\" });"],"type":"codeListing","syntax":"csharp"},{"level":3,"text":"C# Multi File Dialog","type":"heading","anchor":"C-Multi-File-Dialog"},{"code":["MacDialogManager.Instance.MultiFileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Selected {count} files\");","};","MacDialogManager.Instance.ShowMultiFileDialog(\"Select Files\", \"Choose multiple\", new [] { \"png\", \"jpg\" });"],"type":"codeListing","syntax":"csharp"},{"level":3,"text":"C# Folder & Multi Folder","type":"heading","anchor":"C-Folder--Multi-Folder"},{"code":["MacDialogManager.Instance.FolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folder: {paths?[0]}\");","};","MacDialogManager.Instance.ShowFolderDialog(\"Select Folder\", \"Choose a folder\");","","MacDialogManager.Instance.MultiFolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folders: {string.Join(\", \", paths ?? Array.Empty<string>())}\");","};","MacDialogManager.Instance.ShowMultiFolderDialog(\"Select Folders\", \"Choose multiple folders\");"],"type":"codeListing","syntax":"csharp"},{"level":3,"text":"C# Save File Dialog","type":"heading","anchor":"C-Save-File-Dialog"},{"code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"],"type":"codeListing","syntax":"csharp"},{"level":3,"text":"Events Lifecycle Notes","type":"heading","anchor":"Events-Lifecycle-Notes"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Subscribe "},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"type":"text","text":" invoking the corresponding "},{"code":"Show*","type":"codeVoice"},{"type":"text","text":" method to avoid race conditions if a dialog closes quickly (rare but possible)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Unsubscribe when no longer needed to avoid memory leaks in long‑running editor sessions."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Multiple listeners are supported; each is invoked sequentially."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"level":2,"text":"C Bridge Mapping","type":"heading","anchor":"C-Bridge-Mapping"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"C Function","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"C# DllImport Signature (Simplified)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Managed Invoke Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Result Event"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"showDialog","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"void showDialog(string,string,string,string,DialogCallback)"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"AlertDialogResult","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"showFileDialog"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showFileDialog(string,string,IntPtr,int,string,FileDialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowFileDialog(...)","type":"codeVoice"}]}],[{"inlineContent":[{"code":"FileDialogResult","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"showMultiFileDialog","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"void showMultiFileDialog(string,string,IntPtr,int,string,MultiFileDialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowMultiFileDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"MultiFileDialogResult","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"showFolderDialog"}]}],[{"inlineContent":[{"code":"void showFolderDialog(string,string,string,FolderDialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowFolderDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FolderDialogResult"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"showMultiFolderDialog"}]}],[{"inlineContent":[{"code":"void showMultiFolderDialog(string,string,string,MultiFolderDialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowMultiFolderDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"MultiFolderDialogResult","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"showSaveFileDialog","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"void showSaveFileDialog(string,string,string,IntPtr,int,string,SaveFileDialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowSaveFileDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"SaveFileDialogResult","type":"codeVoice"}],"type":"paragraph"}]]]},{"level":3,"text":"Memory Safety in C# Wrapper","type":"heading","anchor":"Memory-Safety-in-C-Wrapper"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Each "},{"code":"string[] allowedContentTypes","type":"codeVoice"},{"type":"text","text":" element is marshalled as an individual unmanaged UTF‑8 buffer + NULL terminator."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A contiguous pointer array is allocated and passed to the C bridge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Cleanup occurs inside the callback’s "},{"code":"finally","type":"codeVoice"},{"text":" block after the Unity main thread event dispatch, ensuring no premature free.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On exceptions during setup, allocated buffers are freed before emitting an error event.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Error Patterns","type":"heading","anchor":"Error-Patterns"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Condition","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Emitted Event Values"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Notes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Empty title"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"buttonIndex \/ fileCount = -1"},{"type":"text","text":", "},{"type":"codeVoice","code":"isSuccess=false"},{"type":"text","text":", error message populated"}]}],[{"inlineContent":[{"text":"Validation short‑circuit","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"No buttons (alert)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"buttonIndex = -1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=false","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DialogError.noButtons","type":"codeVoice"},{"type":"text","text":" equivalent"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"User cancel (panel)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"isCancelled
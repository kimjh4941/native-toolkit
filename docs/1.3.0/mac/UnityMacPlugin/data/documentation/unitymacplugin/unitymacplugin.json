:" text.","type":"text"}],"type":"paragraph"},{"anchor":"Cancellation-Semantics","type":"heading","text":"Cancellation Semantics","level":3},{"inlineContent":[{"type":"text","text":"Cancellation is reported as "},{"type":"codeVoice","code":"isCancelled == true"},{"type":"text","text":" while still treating the operation as logically successful ("},{"type":"codeVoice","code":"isSuccess == true"},{"type":"text","text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set "},{"type":"codeVoice","code":"isSuccess == false"},{"type":"text","text":" and provide an "},{"type":"codeVoice","code":"NSError"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Alert-JSON-Schema","type":"heading","text":"Alert JSON Schema","level":3},{"inlineContent":[{"type":"codeVoice","code":"buttonsJson"},{"type":"text","text":" example:"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"]},{"inlineContent":[{"type":"codeVoice","code":"optionsJson"},{"type":"text","text":" example:"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"]},{"inlineContent":[{"type":"codeVoice","code":"alertStyle"},{"type":"text","text":" accepts: "},{"type":"codeVoice","code":"informational"},{"type":"text","text":" | "},{"type":"codeVoice","code":"warning"},{"type":"text","text":" | "},{"type":"codeVoice","code":"critical"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"File--Folder-Selection","type":"heading","text":"File & Folder Selection","level":3},{"inlineContent":[{"type":"text","text":"File filters are passed as an array of filename extensions (no leading dot) and converted to "},{"type":"codeVoice","code":"UTType"},{"type":"text","text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly."}],"type":"paragraph"},{"anchor":"Save-Panel","type":"heading","text":"Save Panel","level":3},{"type":"paragraph","inlineContent":[{"text":"The save dialog returns a single path. ","type":"text"},{"type":"codeVoice","code":"fileCount"},{"text":" remains for structural symmetry (1 on success, 0 if cancelled).","type":"text"}]},{"type":"heading","level":3,"anchor":"Threading","text":"Threading"},{"inlineContent":[{"type":"text","text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events."}],"type":"paragraph"},{"anchor":"Memory--Lifetime-Notes","type":"heading","text":"Memory & Lifetime Notes","level":3},{"inlineContent":[{"type":"text","text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them ("},{"code":"Marshal.PtrToStringUTF8","type":"codeVoice"},{"type":"text","text":") into managed strings immediately. Caller code only receives safe managed data."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"Unity C# Wrapper (MacDialogManager.cs)","anchor":"Unity-C-Wrapper-MacDialogManagercs","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The provided sample "},{"code":"MacDialogManager","type":"codeVoice"},{"type":"text","text":" MonoBehaviour offers:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lazy singleton creation ("},{"type":"codeVoice","code":"Instance"},{"type":"text","text":" property); object is marked "},{"type":"codeVoice","code":"DontDestroyOnLoad"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Event-based result delivery for each dialog type:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MultiFileDialogResult(…)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FolderDialogResult(…)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MultiFolderDialogResult(…)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"text":"Validation (title, buttons\/options presence) with early error event emission.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Main‑thread dispatch for all event invocations."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"C# Alert Usage","anchor":"C-Alert-Usage","type":"heading","level":3},{"type":"codeListing","syntax":"csharp","code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (succe
{"variants":[{"paths":["\/documentation\/unitymacplugin\/unitymacplugin"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/unitymacplugin\/unitymacplugin"],"traits":[{"interfaceLanguage":"occ"}]}],"kind":"article","identifier":{"url":"doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin\/UnityMacPlugin","interfaceLanguage":"swift"},"abstract":[{"text":"High‑level Unity bridge for macOS dialog presentation built on top of ","type":"text"},{"code":"MacLibrary","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin"]]},"metadata":{"title":"`UnityMacPlugin`","role":"article","roleHeading":"Article","modules":[{"name":"UnityMacPlugin"}]},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"code":"UnityMacPlugin","type":"codeVoice"},{"type":"text","text":" exposes the dialog and file panel functionality implemented in the Swift"},{"type":"text","text":" "},{"code":"MacLibrary\/MacDialogManager","type":"codeVoice"},{"type":"text","text":" to Unity (C#) or other native layers through a thin"},{"type":"text","text":" "},{"type":"text","text":"Objective‑C \/ C bridge. It handles:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Alert dialogs (","type":"text"},{"code":"UnityMacDialogManager\/showDialog(title:message:buttonsJson:optionsJson:completion:)","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single & multi file pickers (open panels)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single & multi folder pickers"}]}]},{"content":[{"inlineContent":[{"text":"Save file dialogs","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inl
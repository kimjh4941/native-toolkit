","code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"],"syntax":"csharp"},{"type":"heading","level":3,"text":"Events Lifecycle Notes","anchor":"Events-Lifecycle-Notes"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Subscribe ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"text":" invoking the corresponding ","type":"text"},{"code":"Show*","type":"codeVoice"},{"text":" method to avoid race conditions if a dialog closes quickly (rare but possible).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Unsubscribe when no longer needed to avoid memory leaks in long‑running editor sessions.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Multiple listeners are supported; each is invoked sequentially.","type":"text"}]}]}]},{"type":"thematicBreak"},{"type":"heading","level":2,"text":"C Bridge Mapping","anchor":"C-Bridge-Mapping"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"C Function"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"C# DllImport Signature (Simplified)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Managed Invoke Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result Event"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"showDialog"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"void showDialog(string,string,string,string,DialogCallback)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ShowDialog(...)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AlertDialogResult"}]}]],[[{"type":
{"kind":"article","sections":[],"abstract":[{"text":"High‑level Unity bridge for macOS dialog presentation built on top of ","type":"text"},{"code":"MacLibrary","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"`UnityMacPlugin`","modules":[{"name":"UnityMacPlugin"}],"roleHeading":"Article","role":"article"},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"code":"UnityMacPlugin","type":"codeVoice"},{"type":"text","text":" exposes the dialog and file panel functionality implemented in the Swift"},{"type":"text","text":" "},{"code":"MacLibrary\/MacDialogManager","type":"codeVoice"},{"type":"text","text":" to Unity (C#) or other native layers through a thin"},{"type":"text","text":" "},{"type":"text","text":"Objective‑C \/ C bridge. It handles:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Alert dialogs (","type":"text"},{"type":"codeVoice","code":"UnityMacDialogManager\/showDialog(title:message:buttonsJson:optionsJson:completion:)"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Single & multi file pickers (open panels)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Single & multi folder pickers","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Save file dialogs","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Suppression checkbox state reporting","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"JSON → Swift option translation for alert configuration","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Safe marshaling of results back to Unity via C function callbacks","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Architecture","text":"Architecture","level":3,"type":"heading"},{"inlineContent":[{"code":"UnityMacDialogManager","type":"codeVoice"},{"type":"text","text":" wraps "},{"code":"MacLibrary\/MacDialogManager","type":"codeVoice"},{"type":"text","text":" and converts strongly typed Swift "},{"code":"Result","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"completions into Objective‑C friendly "},{"code":"(NSDictionary?, NSError?)","type":"codeVoice"},{"type":"text","text":" callbacks. The C bridge functions"},{"type":"text","text":" "},{"type":"text","text":"(defined in "},{"type":"emphasis","inlineContent":[{"text":"UnityMacDialogManagerBridge.h \/ .m","type":"text"}]},{"type":"text","text":") further flatten those into plain C primitives so they can be"},{"type":"text","text":" "},{"type":"text","text":"consumed with P\/Invoke ("},{"code":"[DllImport(\"__Internal\")]","type":"codeVoice"},{"type":"text","text":") from Unity C# code. A managed helper ("},{"code":"MacDialogManager","type":"codeVoice"},{"type":"text","text":" C# MonoBehaviour)"},{"type":"text","text":" "},{"type":"text","text":"exposes idiomatic events, performs marshaling, and handles memory cleanup."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Layering:"}],"type":"paragraph"},{"syntax":null,"code":["Unity C# (MacDialogManager.cs)","   ↓ (P\/Invoke \/ DllImport)","C Bridge (UnityMacDialogManagerBridge.*)","   ↓ (Objective‑C → Swift)","UnityMacDialogManager (Swift facade)","   ↓","MacDialogManager (Core logic)","   ↓","AppKit (NSAlert \/ NSOpenPanel \/ NSSavePanel)"],"type":"codeListing"},{"anchor":"Result-Dictionaries","text":"Result Dictionaries","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each dialog type returns a dictionary with well‑defined keys (all values are Foundation bridged types):"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Dialog Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keys","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Alert","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"buttonTitle:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"buttonIndex:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"suppressionButtonState:Bool","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"File \/ MultiFile \/ Folder \/ MultiFolder","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"filePaths:[String]","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fileCount:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"directoryURL:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isCancelled:Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess:Bool","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Save","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"filePath:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fileCount:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"directoryURL:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isCancelled:Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess:Bool","type":"codeVoice"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Error cases provide an "},{"code":"NSError","type":"codeVoice"},{"type":"text","text":" whose "},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" mirrors "},{"code":"MacLibrary\/DialogError","type":"codeVoice"},{"type":"text","text":" text."}],"type":"paragraph"},{"anchor":"Cancellation-Semantics","text":"Cancellation Semantics","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Cancellation is reported as "},{"code":"isCancelled == true","type":"codeVoice"},{"type":"text","text":" while still treating the operation as logically successful ("},{"code":"isSuccess == true","type":"codeVoice"},{"type":"text","text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set "},{"code":"isSuccess == false","type":"codeVoice"},{"type":"text","text":" and provide an "},{"code":"NSError","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Alert-JSON-Schema","text":"Alert JSON Schema","level":3,"type":"heading"},{"inlineContent":[{"code":"buttonsJson","type":"codeVoice"},{"type":"text","text":" example:"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"],"type":"codeListing"},{"inlineContent":[{"code":"optionsJson","type":"codeVoice"},{"type":"text","text":" example:"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"],"type":"codeListing"},{"inlineContent":[{"code":"alertStyle","type":"codeVoice"},{"type":"text","text":" accepts: "},{"code":"informational","type":"codeVoice"},{"type":"text","text":" | "},{"code":"warning","type":"codeVoice"},{"type":"text","text":" | "},{"code":"critical","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"File--Folder-Selection","text":"File & Folder Selection","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"File filters are passed as an array of filename extensions (no leading dot) and converted to "},{"code":"UTType","type":"codeVoice"},{"type":"text","text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly."}],"type":"paragraph"},{"anchor":"Save-Panel","text":"Save Panel","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The save dialog returns a single path. "},{"code":"fileCount","type":"codeVoice"},{"type":"text","text":" remains for structural symmetry (1 on success, 0 if cancelled)."}],"type":"paragraph"},{"anchor":"Threading","text":"Threading","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events."}],"type":"paragraph"},{"anchor":"Memory--Lifetime-Notes","text":"Memory & Lifetime Notes","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them ("},{"code":"Marshal.PtrToStringUTF8","type":"codeVoice"},{"type":"text","text":") into managed strings immediately. Caller code only receives safe managed data."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"Unity-C-Wrapper-MacDialogManagercs","text":"Unity C# Wrapper (MacDialogManager.cs)","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The provided sample "},{"code":"MacDialogManager","type":"codeVoice"},{"type":"text","text":" MonoBehaviour offers:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Lazy singleton creation (","type":"text"},{"type":"codeVoice","code":"Instance"},{"text":" property); object is marked ","type":"text"},{"type":"codeVoice","code":"DontDestroyOnLoad"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Event-based result delivery for each dialog type:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MultiFileDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FolderDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MultiFolderDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"text":"Validation (title, buttons\/options presence) with early error event emission.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Main‑thread dispatch for all event invocations.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"C-Alert-Usage","text":"C# Alert Usage","level":3,"type":"heading"},{"syntax":"csharp","code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (success) Debug.Log($\"Pressed {title} (index {index}) suppression={suppression}\");","    else Debug.LogError(err);","};","MacDialogManager.Instance.ShowDialog(\"Example\", \"Choose an option\", buttons, options);"],"type":"codeListing"},{"anchor":"C-Single-File-Dialog","text":"C# Single File Dialog","level":3,"type":"heading"},{"syntax":"csharp","code":["MacDialogManager.Instance.FileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (!success) { Debug.LogError(err); return; }","    if (cancelled) Debug.Log(\"User cancelled\"); else Debug.Log(string.Join(\"\\n\", paths));","};","MacDialogManager.Instance.ShowFileDialog(\"Select File\", \"Pick a single file\", new [] { \"txt\", \"md\" });"],"type":"codeListing"},{"anchor":"C-Multi-File-Dialog","text":"C# Multi File Dialog","level":3,"type":"heading"},{"syntax":"csharp","code":["MacDialogManager.Instance.MultiFileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Selected {count} files\");","};","MacDialogManager.Instance.ShowMultiFileDialog(\"Select Files\", \"Choose multiple\", new [] { \"png\", \"jpg\" });"],"type":"codeListing"},{"anchor":"C-Folder--Multi-Folder","text":"C# Folder & Multi Folder","level":3,"type":"heading"},{"syntax":"csharp","code":["MacDialogManager.Instance.FolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folder: {paths?[0]}\");","};","MacDialogManager.Instance.ShowFolderDialog(\"Select Folder\", \"Choose a folder\");","","MacDialogManager.Instance.MultiFolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folders: {string.Join(\", \", paths ?? Array.Empty<string>())}\");","};","MacDialogManager.Instance.ShowMultiFolderDialog(\"Select Folders\", \"Choose multiple folders\");"],"type":"codeListing"},{"anchor":"C-Save-File-Dialog","text":"C# Save File Dialog","level":3,"type":"heading"},{"syntax":"csharp","code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"],"type":"codeListing"},{"anchor":"Events-Lifecycle-Notes","text":"Events Lifecycle Notes","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Subscribe ","type":"text"},{"type":"strong","inlineContent":[{"text":"before","type":"text"}]},{"text":" invoking the corresponding ","type":"text"},{"type":"codeVoice","code":"Show*"},{"text":" method to avoid race conditions if a dialog closes quickly (rare but possible).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Unsubscribe when no longer needed to avoid memory leaks in long‑running editor sessions.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Multiple listeners are supported; each is invoked sequentially.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"anchor":"C-Bridge-Mapping","text":"C Bridge Mapping","level":2,"type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"C Function","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"C# DllImport Signature (Simplified)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Managed Invoke Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Result Event","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showDialog","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showDialog(string,string,string,string,DialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"AlertDialogResult","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showFileDialog","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showFileDialog(string,string,IntPtr,int,string,FileDialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowFileDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"FileDialogResult","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showMultiFileDialog","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showMultiFileDialog(string,string,IntPtr,int,string,MultiFileDialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowMultiFileDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"MultiFileDialogResult","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showFolderDialog","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showFolderDialog(string,string,string,FolderDialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowFolderDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"FolderDialogResult","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showMultiFolderDialog","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showMultiFolderDialog(string,string,string,MultiFolderDialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowMultiFolderDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"MultiFolderDialogResult","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showSaveFileDialog","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showSaveFileDialog(string,string,string,IntPtr,int,string,SaveFileDialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowSaveFileDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"SaveFileDialogResult","type":"codeVoice"}]}]]],"type":"table"},{"anchor":"Memory-Safety-in-C-Wrapper","text":"Memory Safety in C# Wrapper","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"string[] allowedContentTypes"},{"text":" element is marshalled as an individual unmanaged UTF‑8 buffer + NULL terminator.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A contiguous pointer array is allocated and passed to the C bridge.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Cleanup occurs inside the callback’s ","type":"text"},{"type":"codeVoice","code":"finally"},{"text":" block after the Unity main thread event dispatch, ensuring no premature free.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On exceptions during setup, allocated buffers are freed before emitting an error event.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Error-Patterns","text":"Error Patterns","level":3,"type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Condition","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Emitted Event Values","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Notes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Empty title","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"buttonIndex \/ fileCount = -1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=false","type":"codeVoice"},{"text":", error message populated","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Validation short‑circuit","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"No buttons (alert)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"buttonIndex = -1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=false","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"DialogError.noButtons","type":"codeVoice"},{"text":" equivalent","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"User cancel (panel)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"isCancelled=true","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=true","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Not an error","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Runtime failure","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"isSuccess=false","type":"codeVoice"},{"text":", error message","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Underlying Swift error","type":"text"}]}]]],"type":"table"},{"anchor":"Suppression-Checkbox","text":"Suppression Checkbox","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"If "},{"code":"showsSuppressionButton=true","type":"codeVoice"},{"type":"text","text":" and the user checks it, "},{"code":"suppressionButtonState","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" in the alert callback—persist preference in your own config (e.g. PlayerPrefs \/ JSON file)."}],"type":"paragraph"},{"anchor":"Localization","text":"Localization","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"All strings are caller‑supplied; localize before passing into the plugin if your game supports multiple languages."}],"type":"paragraph"},{"anchor":"Testing-Tips","text":"Testing Tips","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Use Console.app (filter by subsystem\/category if you wrap ","type":"text"},{"type":"codeVoice","code":"Log"},{"text":") or Xcode debug console to inspect native logging.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Simulate cancellation paths early (press ESC or click Cancel).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Provide invalid JSON intentionally to verify graceful error handling (ensure you restore correct JSON afterward).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Extensibility","text":"Extensibility","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"To add a new dialog category:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Extend ","type":"text"},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add a Swift bridging method in ","type":"text"},{"type":"codeVoice","code":"UnityMacDialogManager"},{"text":" that flattens the result to ","type":"text"},{"type":"codeVoice","code":"NSDictionary"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Add a C bridge function + C typedef.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Notification-Bridge","text":"Notification Bridge","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"UnityMacNotificationManager"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"UnityMacNotificationJsonParser"}],"type":"paragraph"}]}],"type":"unorderedList"},{"items":[{"content":[{"inlineContent":[{"text":"Extend ","type":"text"},{"type":"codeVoice","code":"MacDialogManager.cs"},{"text":" with DllImport, delegate, event, and a public ","type":"text"},{"type":"codeVoice","code":"Show*"},{"text":" method.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Update this document & provide new C# usage examples.","type":"text"}],"type":"paragraph"}]}],"start":4,"type":"orderedList"},{"type":"thematicBreak"},{"anchor":"Quick-Start-Unity-C","text":"Quick Start (Unity C#)","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"(See expanded examples above.) Minimal alert recap:"}],"type":"paragraph"},{"syntax":"csharp","code":["MacDialogManager.Instance.AlertDialogResult += (t,i,s,ok,err)=>Debug.Log($\"Pressed {t} idx={i} ok={ok}\");","MacDialogManager.Instance.ShowDialog(","    \"Hello\",","    \"From Unity\",","    new[]{ new DialogButton{ title=\"OK\", isDefault=true }, new DialogButton{ title=\"Cancel\" } },","    new DialogOptions{ alertStyle=\"informational\" }",");"],"type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin\/UnityMacPlugin"},"variants":[{"paths":["\/documentation\/unitymacplugin\/unitymacplugin"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/unitymacplugin\/unitymacplugin"],"traits":[{"interfaceLanguage":"occ"}]}],"hierarchy":{"paths":[["doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin"]]},"references":{"doc://unity.mac.plugin.UnityMacPlugin/documentation/UnityMacPlugin":{"type":"topic","abstract":[],"kind":"symbol","title":"UnityMacPlugin","identifier":"doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin","role":"collection","url":"\/documentation\/unitymacplugin"}},"variantOverrides":[{"traits":[{"interfaceLanguage":"occ"}],"patch":[{"op":"replace","path":"\/identifier\/interfaceLanguage","value":"occ"},{"op":"add","path":"\/topicSections","value":null},{"op":"add","path":"\/seeAlsoSections","value":null}]}]}
text":"Cancellation Semantics","anchor":"Cancellation-Semantics","level":3,"type":"heading"},{"inlineContent":[{"text":"Cancellation is reported as ","type":"text"},{"type":"codeVoice","code":"isCancelled == true"},{"text":" while still treating the operation as logically successful (","type":"text"},{"type":"codeVoice","code":"isSuccess == true"},{"text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set ","type":"text"},{"type":"codeVoice","code":"isSuccess == false"},{"text":" and provide an ","type":"text"},{"type":"codeVoice","code":"NSError"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Alert JSON Schema","anchor":"Alert-JSON-Schema","level":3,"type":"heading"},{"inlineContent":[{"code":"buttonsJson","type":"codeVoice"},{"text":" example:","type":"text"}],"type":"paragraph"},{"code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"code":"optionsJson","type":"codeVoice"},{"type":"text","text":" example:"}],"type":"paragraph"},{"code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"code":"alertStyle","type":"codeVoice"},{"type":"text","text":" accepts: "},{"type":"codeVoice","code":"informational"},{"type":"text","text":" | "},{"code":"warning","type":"codeVoice"},{"text":" | ","type":"text"},{"code":"critical","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"File--Folder-Selection","text":"File & Folder Selection"},{"type":"paragraph","inlineContent":[{"text":"File filters are passed as an array of filename extensions (no leading dot) and converted to ","type":"text"},{"code":"UTType","type":"codeVoice"},{"text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly.","type":"text"}]},{"type":"heading","level":3,"anchor":"Save-Panel","text":"Save Panel"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The save dialog returns a single path. "},{"type":"codeVoice","code":"fileCount"},{"type":"text","text":" remains for structural symmetry (1 on success, 0 if cancelled)."}]},{"type":"heading","level":3,"anchor":"Threading","text":"Threading"},{"type":"paragraph","inlineContent":[{"text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events.","type":"text"}]},{"type":"heading","level":3,"anchor":"Memory--Lifetime-Notes","text":"Memory & Lifetime Notes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them ("},{"code":"Marshal.PtrToStringUTF8","type":"codeVoice"},{"type":"text","text":") into managed strings immediately. Caller code only receives safe managed data."}]},{"type":"thematicBreak"},{"type":"heading","level":2,"anchor":"Unity-C-Wrapper-MacDialogManagercs","text":"Unity C# Wrapper (MacDialogManager.cs)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The provided sample "},{"type":"codeVoice","code":"MacDialogManager"},{"type":"text","text":" MonoBehaviour offers:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Lazy singleton creation ("},{"code":"Instance","type":"codeVoice"},{"type":"text","text":" property); object is marked "},{"code":"DontDestroyOnLoad","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Event-based result delivery for each dialog type:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MultiFileDialogResult(…)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FolderDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MultiFolderDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]}]}]},{"content":[{"inlineContent":[{"text":"Validation (title, buttons\/options presence) with early error event emission.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Main‑thread dispatch for all event invocations."}]}]}]},{"level":3,"anchor":"C-Alert-Usage","type":"heading","text":"C# Alert Usage"},{"code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (success) Debug.Log($\"Pressed {title} (index {index}) suppression={suppression}\");","    else Debug.LogError(err);","};","MacDialogManager.Instance.ShowDialog(\"Example\", \"Choose an option\", buttons, options);"],"type":"codeListing","syntax":"csharp"},{"text":"C# Single File Dialog","anchor":"C-Single-File-Dialog","level":3,"type":"heading"},{"code":["MacDialogManager.Instance.FileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (!success) { Debug.LogError(err); return; }","    if (cancelled) Debug.Log(\"User cancelled\"); else Debug.Log(string.Join(\"\\n\", paths));","};","MacDialogManager.Instance.ShowFileDialog(\"Select File\", \"Pick a single file\", new [] { \"txt\", \"md\" });"],"type":"codeListing","syntax":"csharp"},{"text":"C# Multi File Dialog","anchor":"C-Multi-File-Dialog","level":3,"type":"heading"},{"syntax":"csharp","type":"codeListing","code":["MacDialogManager.Instance.MultiFileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Selected {count} files\");","};","MacDialogManager.Instance.ShowMultiFileDialog(\"Select Files\", \"Choose multiple\", new [] { \"png\", \"jpg\" });"]},{"anchor":"C-Folder--Multi-Folder","type":"heading","level":3,"text":"C# Folder & Multi Folder"},{"syntax":"csharp","type":"codeListing","code":["MacDialogManager.Instance.FolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folder: {paths?[0]}\");","};","MacDialogManager.Instance.ShowFolderDialog(\"Select Folder\", \"Choose a folder\");","","MacDialogManager.Instance.MultiFolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folders: {string.Join(\", \", paths ?? Array.Empty<string>())}\");","};","MacDialogManager.Instance.ShowMultiFolderDialog(\"Select Folders\", \"Choose multiple folders\");"]},{"anchor":"C-Save-File-Dialog","type":"heading","level":3,"text":"C# Save File Dialog"},{"syntax":"csharp","type":"codeListing","code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"]},{"anchor":"Events-Lifecycle-Notes","type":"heading","level":3,"text":"Events Lifecycle Notes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Subscribe ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"text":" invoking the corresponding ","type":"text"},{"code":"Show*","type":"codeVoice"},{"text":" method to avoid race conditions if a dialog closes quickly (rare but possible).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Unsubscribe when no longer needed to avoid memory leaks in long‑running editor sessions."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Multiple listeners are supported; each is invoked sequentially."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"anchor":"C-Bridge-Mapping","type":"heading","level":2,"text":"C Bridge Mapping"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"C Function"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"C# DllImport Signature (Simplified)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Managed Invoke Method","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result Event"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"showDialog"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showDialog(string,string,string,string,DialogCallback)","type":"codeVoice"}]}],[{"inlineContent":[{"code":"ShowDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"AlertDialogResult","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","co
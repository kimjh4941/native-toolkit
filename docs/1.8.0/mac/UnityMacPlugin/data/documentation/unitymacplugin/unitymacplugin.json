{"kind":"article","identifier":{"url":"doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin\/UnityMacPlugin","interfaceLanguage":"swift"},"metadata":{"title":"`UnityMacPlugin`","roleHeading":"Article","modules":[{"name":"UnityMacPlugin"}],"role":"article"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/unitymacplugin\/unitymacplugin"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/unitymacplugin\/unitymacplugin"]}],"abstract":[{"text":"High‑level Unity bridge for macOS dialog presentation built on top of ","type":"text"},{"code":"MacLibrary","type":"codeVoice"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin"]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UnityMacPlugin"},{"type":"text","text":" exposes the dialog and file panel functionality implemented in the Swift"},{"type":"text","text":" "},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"type":"text","text":" to Unity (C#) or other native layers through a thin"},{"type":"text","text":" "},{"type":"text","text":"Objective‑C \/ C bridge. It handles:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alert dialogs ("},{"type":"codeVoice","code":"UnityMacDialogManager\/showDialog(title:message:buttonsJson:optionsJson:completion:)"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Single & multi file pickers (open panels)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single & multi folder pickers","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Save file dialogs"}]}]},{"content":[{"inlineContent":[{"text":"Suppression checkbox state reporting","type":"text"}],"type":"paragr
{"sections":[],"abstract":[{"type":"text","text":"High‑level Unity bridge for macOS dialog presentation built on top of "},{"code":"MacLibrary","type":"codeVoice"},{"type":"text","text":"."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"UnityMacPlugin"},{"text":" exposes the dialog and file panel functionality implemented in the Swift","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"text":" to Unity (C#) or other native layers through a thin","type":"text"},{"text":" ","type":"text"},{"text":"Objective‑C \/ C bridge. It handles:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Alert dialogs ("},{"code":"UnityMacDialogManager\/showDialog(title:message:buttonsJson:optionsJson:completion:)","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single & multi file pickers (open panels)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Single & multi folder pickers"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Save file dialogs","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Suppression checkbox state reporting"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"JSON → Swift option translation for alert configuration"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Safe marshaling of results back to Unity via C function callbacks"}]}]}],"type":"unorderedList"},{"text":"Architecture","type":"heading","level":3,"anchor":"Architecture"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UnityMacDialogManager"},{"type":"text","text":" wraps "},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"text":" and converts strongly typed Swift ","type":"text"},{"type":"codeVoice","code":"Result"},{"type":"text","text":" "},{"text":"completions into Objective‑C friendly ","type":"text"},{"type":"codeVoice","code":"(NSDictionary?, NSError?)"},{"text":" callbacks. The C bridge functions","type":"text"},{"text":" ","type":"text"},{"text":"(defined in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"UnityMacDialogManagerBridge.h \/ .m"}]},{"type":"text","text":") further flatten those into plain C primitives so they can be"},{"type":"text","text":" "},{"type":"text","text":"consumed with P\/Invoke ("},{"code":"[DllImport(\"__Internal\")]","type":"codeVoice"},{"text":") from Unity C# code. A managed helper (","type":"text"},{"type":"codeVoice","code":"MacDialogManager"},{"text":" C# MonoBehaviour)","type":"text"},{"text":" ","type":"text"},{"text":"exposes idiomatic events, performs marshaling, and handles memory cleanup.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Layering:","type":"text"}]},{"type":"codeListing","code":["Unity C# (MacDialogManager.cs)","   ↓ (P\/Invoke \/ DllImport)","C Bridge (UnityMacDialogManagerBridge.*)","   ↓ (Objective‑C → Swift)","UnityMacDialogManager (Swift facade)","   ↓","MacDialogManager (Core logic)","   ↓","AppKit (NSAlert \/ NSOpenPanel \/ NSSavePanel)"],"syntax":null},{"text":"Result Dictionaries","level":3,"type":"heading","anchor":"Result-Dictionaries"},{"inlineContent":[{"text":"Each dialog type returns a dictionary with well‑defined keys (all values are Foundation bridged types):","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dialog Type"}]}],[{"inlineContent":[{"type":"text","text":"Keys"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Alert","type":"text"}]}],[{"inlineContent":[{"type":"codeVoice","code":"buttonTitle:String"},{"type":"text","text":", "},{"type":"codeVoice","code":"buttonIndex:Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"suppressionButtonState:Bool"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"File \/ MultiFile \/ Folder \/ MultiFolder"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"filePaths:[String]","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"fileCount:Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"directoryURL:String"},{"text":", ","type":"text"},{"code":"isCancelled:Bool","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"isSuccess:Bool"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Save"}]}],[{"inlineContent":[{"type":"codeVoice","code":"filePath:String"},{"text":", ","type":"text"},{"type":"codeVoice","code":"fileCount:Int"},{"text":", ","type":"text"},{"code":"directoryURL:String","type":"codeVoice"},{"type":"text","text":", "},{"code":"isCancelled:Bool","type":"codeVoice"},{"type":"text","text":", "},{"code":"isSuccess:Bool","type":"codeVoice"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"Error cases provide an "},{"code":"NSError","type":"codeVoice"},{"type":"text","text":" whose "},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" mirrors "},{"code":"MacLibrary\/DialogError","type":"codeVoice"},{"text":" text.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Cancellation-Semantics","type":"heading","text":"Cancellation Semantics"},{"inlineContent":[{"text":"Cancellation is reported as ","type":"text"},{"type":"codeVoice","code":"isCancelled == true"},{"text":" while still treating the operation as logically successful (","type":"text"},{"type":"codeVoice","code":"isSuccess == true"},{"text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set ","type":"text"},{"type":"codeVoice","code":"isSuccess == false"},{"type":"text","text":" and provide an "},{"type":"codeVoice","code":"NSError"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Alert JSON Schema","type":"heading","level":3,"anchor":"Alert-JSON-Schema"},{"inlineContent":[{"type":"codeVoice","code":"buttonsJson"},{"text":" example:","type":"text"}],"type":"paragraph"},{"code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"code":"optionsJson","type":"codeVoice"},{"text":" example:","type":"text"}],"type":"paragraph"},{"code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"code":"alertStyle","type":"codeVoice"},{"text":" accepts: ","type":"text"},{"code":"informational","type":"codeVoice"},{"text":" | ","type":"text"},{"code":"warning","type":"codeVoice"},{"text":" | ","type":"text"},{"code":"critical","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"File--Folder-Selection","type":"heading","text":"File & Folder Selection"},{"inlineContent":[{"text":"File filters are passed as an array of filename extensions (no leading dot) and converted to ","type":"text"},{"code":"UTType","type":"codeVoice"},{"text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly.","type":"text"}],"type":"paragraph"},{"text":"Save Panel","anchor":"Save-Panel","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The save dialog returns a single path. "},{"code":"fileCount","type":"codeVoice"},{"type":"text","text":" remains for structural symmetry (1 on success, 0 if cancelled)."}],"type":"paragraph"},{"text":"Threading","anchor":"Threading","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events."}],"type":"paragraph"},{"text":"Memory & Lifetime Notes","anchor":"Memory--Lifetime-Notes","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them ("},{"code":"Marshal.PtrToStringUTF8","type":"codeVoice"},{"type":"text","text":") into managed strings immediately. Caller code only receives safe managed data."}],"type":"paragraph"},{"type":"thematicBreak"},{"text":"Unity C# Wrapper (MacDialogManager.cs)","anchor":"Unity-C-Wrapper-MacDialogManagercs","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The provided sample "},{"code":"MacDialogManager","type":"codeVoice"},{"type":"text","text":" MonoBehaviour offers:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Lazy singleton creation (","type":"text"},{"type":"codeVoice","code":"Instance"},{"text":" property); object is marked ","type":"text"},{"type":"codeVoice","code":"DontDestroyOnLoad"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Event-based result delivery for each dialog type:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MultiFileDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FolderDialogResult(…)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MultiFolderDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}]}]}]}]},{"content":[{"inlineContent":[{"text":"Validation (title, buttons\/options presence) with early error event emission.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Main‑thread dispatch for all event invocations.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"C-Alert-Usage","type":"heading","level":3,"text":"C# Alert Usage"},{"code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (success) Debug.Log($\"Pressed {title} (index {index}) suppression={suppression}\");","    else Debug.LogError(err);","};","MacDialogManager.Instance.ShowDialog(\"Example\", \"Choose an option\", buttons, options);"],"type":"codeListing","syntax":"csharp"},{"type":"heading","level":3,"anchor":"C-Single-File-Dialog","text":"C# Single File Dialog"},{"syntax":"csharp","type":"codeListing","code":["MacDialogManager.Instance.FileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (!success) { Debug.LogError(err); return; }","    if (cancelled) Debug.Log(\"User cancelled\"); else Debug.Log(string.Join(\"\\n\", paths));","};","MacDialogManager.Instance.ShowFileDialog(\"Select File\", \"Pick a single file\", new [] { \"txt\", \"md\" });"]},{"anchor":"C-Multi-File-Dialog","type":"heading","level":3,"text":"C# Multi File Dialog"},{"syntax":"csharp","type":"codeListing","code":["MacDialogManager.Instance.MultiFileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Selected {count} files\");","};","MacDialogManager.Instance.ShowMultiFileDialog(\"Select Files\", \"Choose multiple\", new [] { \"png\", \"jpg\" });"]},{"text":"C# Folder & Multi Folder","level":3,"anchor":"C-Folder--Multi-Folder","type":"heading"},{"code":["MacDialogManager.Instance.FolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folder: {paths?[0]}\");","};","MacDialogManager.Instance.ShowFolderDialog(\"Select Folder\", \"Choose a folder\");","","MacDialogManager.Instance.MultiFolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folders: {string.Join(\", \", paths ?? Array.Empty<string>())}\");","};","MacDialogManager.Instance.ShowMultiFolderDialog(\"Select Folders\", \"Choose multiple folders\");"],"type":"codeListing","syntax":"csharp"},{"anchor":"C-Save-File-Dialog","type":"heading","level":3,"text":"C# Save File Dialog"},{"code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"],"type":"codeListing","syntax":"csharp"},{"text":"Events Lifecycle Notes","anchor":"Events-Lifecycle-Notes","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Subscribe "},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"typ
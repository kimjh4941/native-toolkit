nd passed to the C bridge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Cleanup occurs inside the callback’s "},{"type":"codeVoice","code":"finally"},{"type":"text","text":" block after the Unity main thread event dispatch, ensuring no premature free."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"On exceptions during setup, allocated buffers are freed before emitting an error event."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Error-Patterns","type":"heading","level":3,"text":"Error Patterns"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Condition","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Emitted Event Values","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Notes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Empty title","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"buttonIndex \/ fileCount = -1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=false","type":"codeVoice"},{"text":", error message populated","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Validation short‑circuit","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"No buttons (alert)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"buttonIndex = -1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=false","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"DialogError.noButtons","type":"codeVoice"},{"text":" equivalent","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"User cancel (panel)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"isCancelled=true","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=true","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Not an error","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{
cDialogManager"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add a Swift bridging method in "},{"type":"codeVoice","code":"UnityMacDialogManager"},{"type":"text","text":" that flattens the result to "},{"type":"codeVoice","code":"NSDictionary"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Add a C bridge function + C typedef."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Notification-Bridge","type":"heading","level":3,"text":"Notification Bridge"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"UnityMacNotificationManager"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"UnityMacNotificationJsonParser"}],"type":"paragraph"}]}],"type":"unorderedList"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Extend "},{"type":"codeVoice","code":"MacDialogManager.cs"},{"type":"text","text":" with DllImport, delegate, event, and a public "},{"type":"codeVoice","code":"Show*"},{"type":"text","text":" method."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Update this document & provide new C# usage examples."}],"type":"paragraph"}]}],"type":"orderedList","start":4},{"type":"thematicBreak"},{"anchor":"Quick-Start-Unity-C","type":"heading","level":2,"text":"Quick Start (Unity C#)"},{"inlineContent":[{"text":"(See expanded examples above.) Minimal alert recap:","type":"text"}],"type":"paragraph"},{"code":["MacDialogManager.Instance.AlertDialogResult += (t,i,s,ok,err)=>Debug.Log($\"Pressed {t} idx={i} ok={ok}\");","MacDialogManager.Instance.ShowDialog(","    \"Hello\",","    \"From Unity\",","    new[]{ new DialogButton{ title=\"OK\", isDefault=true }, new DialogButton{ title=\"Cancel\" } },","    new DialogOptions{ alertStyle=\"informational\" }",");"],"type":"codeListing","syntax":"csharp"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/unity.mac.plugin.
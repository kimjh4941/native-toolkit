{"abstract":[{"type":"text","text":"High‑level Unity bridge for macOS dialog presentation built on top of "},{"type":"codeVoice","code":"MacLibrary"},{"text":".","type":"text"}],"metadata":{"modules":[{"name":"UnityMacPlugin"}],"roleHeading":"Article","title":"`UnityMacPlugin`","role":"article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"code":"UnityMacPlugin","type":"codeVoice"},{"type":"text","text":" exposes the dialog and file panel functionality implemented in the Swift"},{"type":"text","text":" "},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"type":"text","text":" to Unity (C#) or other native layers through a thin"},{"type":"text","text":" "},{"text":"Objective‑C \/ C bridge. It handles:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alert dialogs ("},{"code":"UnityMacDialogManager\/showDialog(title:message:buttonsJson:optionsJson:completion:)","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single & multi file pickers (open panels)"}]}]},{"content":[{"inlineContent":[{"text":"Single & multi folder pickers","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Save file dialogs","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Suppression checkbox state reporting","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"JSON → Swift option translation for alert configuration","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Safe marshaling of results back to Unity via C function callbacks","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"anchor":"Architecture","text":"Architecture"},{"type":"paragraph","inlineContent":[{"code":"UnityMacDialogManager","type":"codeVoice"},{"type":"text","text":" wraps "},{"code":"MacLibrary\/MacDialogManager","type":"codeVoice"},{"type":"text","text":" and converts strongly typed Swift "},{"code":"Result","type":"codeVoice"},{"type":"text","text":" "},{"text":"completions into Objective‑C friendly ","type":"text"},{"code":"(NSDictionary?, NSError?)","type":"codeVoice"},{"text":" callbacks. The C bridge functions","type":"text"},{"text":" ","type":"text"},{"text":"(defined in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"UnityMacDialogManagerBridge.h \/ .m"}]},{"text":") further flatten those into plain C primitives so they can be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"consumed with P\/Invoke ("},{"code":"[DllImport(\"__Internal\")]","type":"codeVoice"},{"text":") from Unity C# code. A managed helper (","type":"text"},{"code":"MacDialogManager","type":"codeVoice"},{"type":"text","text":" C# MonoBehaviour)"},{"text":" ","type":"text"},{"text":"exposes idiomatic events, performs marshaling, and handles memory cleanup.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Layering:","type":"text"}]},{"syntax":null,"code":["Unity C# (MacDialogManager.cs)","   ↓ (P\/Invoke \/ DllImport)","C Bridge (UnityMacDialogManagerBridge.*)","   ↓ (Objective‑C → Swift)","UnityMacDialogManager (Swift facade)","   ↓","MacDialogManager (Core logic)","   ↓","AppKit (NSAlert \/ NSOpenPanel \/ NSSavePanel)"],"type":"codeListing"},{"anchor":"Result-Dictionaries","level":3,"type":"heading","text":"Result Dictionaries"},{"inlineContent":[{"type":"text","text":"Each dialog type returns a dictionary with well‑defined keys (all values are Foundation bridged types):"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Dialog Type","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keys"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Alert","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"buttonTitle:String","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"buttonIndex:Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"suppressionButtonState:Bool"}]}]],[[{"inlineContent":[{"text":"File \/ MultiFile \/ Folder \/ MultiFolder","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"filePaths:[String]"},{"text":", ","type":"text"},{"code":"fileCount:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"directoryURL:String","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"isCancelled:Bool"},{"text":", ","type":"text"},{"code":"isSuccess:Bool","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Save","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"filePath:String"},{"type":"text","text":", "},{"type":"codeVoice","code":"fileCount:Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"directoryURL:String"},{"type":"text","text":", "},{"type":"codeVoice","code":"isCancelled:Bool"},{"text":", ","type":"text"},{"type":"codeVoice","code":"isSuccess:Bool"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"Error cases provide an ","type":"text"},{"type":"codeVoice","code":"NSError"},{"text":" whose ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":" mirrors ","type":"text"},{"code":"MacLibrary\/DialogError","type":"codeVoice"},{"text":" text.","type":"text"}],"type":"paragraph"},{"anchor":"Cancellation-Semantics","level":3,"text":"Cancellation Semantics","type":"heading"},{"inlineContent":[{"text":"Cancellation is reported as ","type":"text"},{"code":"isCancelled == true","type":"codeVoice"},{"text":" while still treating the operation as logically successful (","type":"text"},{"code":"isSuccess == true","type":"codeVoice"},{"text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set ","type":"text"},{"code":"isSuccess == false","type":"codeVoice"},{"text":" and provide an ","type":"text"},{"code":"NSError","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Alert JSON Schema","level":3,"anchor":"Alert-JSON-Schema","type":"heading"},{"inlineContent":[{"code":"buttonsJson","type":"codeVoice"},{"text":" example:","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"],"type":"codeListing"},{"inlineContent":[{"code":"optionsJson","type":"codeVoice"},{"text":" example:","type":"text"}],"type":"paragraph"},{"code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"code":"alertStyle","type":"codeVoice"},{"text":" accepts: ","type":"text"},{"code":"informational","type":"codeVoice"},{"text":" | ","type":"text"},{"code":"warning","type":"codeVoice"},{"type":"text","text":" | "},{"code":"critical","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"File & Folder Selection","anchor":"File--Folder-Selection","type":"heading"},{"inlineContent":[{"text":"File filters are passed as an array of filename extensions (no leading dot) and converted to ","type":"text"},{"code":"UTType","type":"codeVoice"},{"text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Save-Panel","type":"heading","text":"Save Panel"},{"inlineContent":[{"text":"The save dialog returns a single path. ","type":"text"},{"code":"fileCount","type":"codeVoice"},{"type":"text","text":" remains for structural symmetry (1 on success, 0 if cancelled)."}],"type":"paragraph"},{"level":3,"anchor":"Threading","type":"heading","text":"Threading"},{"type":"paragraph","inlineContent":[{"text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events.","type":"text"}]},{"type":"heading","text":"Memory & Lifetime Notes","level":3,"anchor":"Memory--Lifetime-Notes"},{"inlineContent":[{"text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them (","type":"text"},{"code":"Marshal.PtrToStringUTF8","type":"codeVoice"},{"type":"text","text":") into managed strings immediately. Caller code only receives safe managed data."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"Unity-C-Wrapper-MacDialogManagercs","level":2,"text":"Unity C# Wrapper (MacDialogManager.cs)","type":"heading"},{"inlineContent":[{"type":"text","text":"The provided sample "},{"code":"MacDialogManager","type":"codeVoice"},{"text":" MonoBehaviour offers:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Lazy singleton creation ("},{"code":"Instance","type":"codeVoice"},{"text":" property); object is marked ","type":"text"},{"code":"DontDestroyOnLoad","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Event-based result delivery for each dialog type:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MultiFileDialogResult(…)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FolderDialogResult(…)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MultiFolderDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]}]}]},{"content":[{"inlineContent":[{"text":"Validation (title, buttons\/options presence) with early error event emission.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Main‑thread dispatch for all event invocations.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"C# Alert Usage","type":"heading","level":3,"anchor":"C-Alert-Usage"},{"syntax":"csharp","code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (success) Debug.Log($\"Pressed {title} (index {index}) suppression={suppression}\");","    else Debug.LogError(err);","};","MacDialogManager.Instance.ShowDialog(\"Example\", \"Choose an option\", buttons, options);"],"type":"codeListing"},{"text":"C# Single File Dialog","level":3,"anchor":"C-Single-File-Dialog","type":"heading"},{"syntax":"csharp","code":["MacDialogManager.Instance.FileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (!success) { Debug.LogError(err); return; }","    if (cancelled) Debug.Log(\"User cancelled\"); else Debug.Log(string.Join(\"\\n\", paths));","};","MacDialogManager.Instance.ShowFileDialog(\"Select File\", \"Pick a single file\", new [] { \"txt\", \"md\" });"],"type":"codeListing"},{"anchor":"C-Multi-File-Dialog","level":3,"text":"C# Multi File Dialog","type":"heading"},{"syntax":"csharp","code":["MacDialogManager.Instance.MultiFileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Selected {count} files\");","};","MacDialogManager.Instance.ShowMultiFileDialog(\"Select Files\", \"Choose multiple\", new [] { \"png\", \"jpg\" });"],"type":"codeListing"},{"anchor":"C-Folder--Multi-Folder","level":3,"text":"C# Folder & Multi Folder","type":"heading"},{"syntax":"csharp","code":["MacDialogManager.Instance.FolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folder: {paths?[0]}\");","};","MacDialogManager.Instance.ShowFolderDialog(\"Select Folder\", \"Choose a folder\");","","MacDialogManager.Instance.MultiFolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folders: {string.Join(\", \", paths ?? Array.Empty<string>())}\");","};","MacDialogManager.Instance.ShowMultiFolderDialog(\"Select Folders\", \"Choose multiple folders\");"],"type":"codeListing"},{"anchor":"C-Save-File-Dialog","level":3,"text":"C# Save File Dialog","type":"heading"},{"syntax":"csharp","code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"],"type":"codeListing"},{"anchor":"Events-Lifecycle-Notes","level":3,"text":"Events Lifecycle Notes","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Subscribe ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"text":" invoking the corresponding ","type":"text"},{"type":"codeVoice","code":"Show*"},{"type":"text","text":" method to avoid race conditions if a dialog closes quickly (rare but possible)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Unsubscribe when no longer needed to avoid memory leaks in long‑running editor sessions.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Multiple listeners are supported; each is invoked sequentially."}]}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"anchor":"C-Bridge-Mapping","level":2,"text":"C Bridge Mapping","type":"heading"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"C Function","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"C# DllImport Signature (Simplified)","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Managed Invoke Method","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Result Event"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"showDialog","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"void showDialog(string,string,string,string,DialogCallback)"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AlertDialogResult"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showFileDialog","type":"codeVoice"}]}],[{"inlineContent":[{"code":"void showFileDialog(string,string,IntPtr,int,string,FileDialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowFileDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"FileDialogResult","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"showMultiFileDialog","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"void showMultiFileDialog(string,string,IntPtr,int,string,MultiFileDialogCallback)"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowMultiFileDialog(...)","type":"codeVoice"}]}],[{"inlineContent":[{"code":"MultiFileDialogResult","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"showFolderDialog","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"void showFolderDialog(string,string,string,FolderDialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowFolderDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"FolderDialogResult","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"showMultiFolderDialog","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"void showMultiFolderDialog(string,string,string,MultiFolderDialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowMultiFolderDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"MultiFolderDialogResult","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"showSaveFileDialog","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"void showSaveFileDialog(string,string,string,IntPtr,int,string,SaveFileDialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ShowSaveFileDialog(...)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"SaveFileDialogResult","type":"codeVoice"}],"type":"paragraph"}]]]},{"level":3,"text":"Memory Safety in C# Wrapper","anchor":"Memory-Safety-in-C-Wrapper","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Each ","type":"text"},{"code":"string[] allowedContentTypes","type":"codeVoice"},{"text":" element is marshalled as an individual unmanaged UTF‑8 buffer + NULL terminator.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A contiguous pointer array is allocated and passed to the C bridge.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cleanup occurs inside the callback’s ","type":"text"},{"code":"finally","type":"codeVoice"},{"type":"text","text":" block after the Unity main thread event dispatch, ensuring no premature free."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"On exceptions during setup, allocated buffers are freed before emitting an error event.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Error Patterns","level":3,"type":"heading","anchor":"Error-Patterns"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Condition","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Emitted Event Values","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Notes","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"Empty title"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"buttonIndex \/ fileCount = -1"},{"text":", ","type":"text"},{"code":"isSuccess=false","type":"codeVoice"},{"type":"text","text":", error message populated"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Validation short‑circuit","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"No buttons (alert)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"buttonIndex = -1","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=false","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DialogError.noButtons","type":"codeVoice"},{"type":"text","text":" equivalent"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"User cancel (panel)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"isCancelled=true","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=true","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No
{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UnityMacPlugin"},{"text":" exposes the dialog and file panel functionality implemented in the Swift","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"type":"text","text":" to Unity (C#) or other native layers through a thin"},{"text":" ","type":"text"},{"text":"Objective‑C \/ C bridge. It handles:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alert dialogs ("},{"code":"UnityMacDialogManager\/showDialog(title:message:buttonsJson:optionsJson:completion:)","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single & multi file pickers (open panels)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single & multi folder pickers","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Save file dialogs"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Suppression checkbox state reporting","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"JSON → Swift option translation for alert configuration","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Safe marshaling of results back to Unity via C function callbacks"}]}]}]},{"type":"heading","text":"Architecture","anchor":"Architecture","level":3},{"inlineContent":[{"type":"codeVoice","code":"UnityMacDialogManager"},{"type":"text","text":" wraps "},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"type":"text","text":" and converts strongly typed Swift "},{"type":"codeVoice","code":"Result"},{"type":"text","text":" "},{"type":"text","text":"completions into Objective‑C friendly "},{"type":"codeVoice","code":"(NSDictionary?, NSError?)"},{"type":"text","text":" callbacks. The C bridge functions"},{"type":"text","text":" "},{"type":"text","text":"(defined in "},{"type":"emphasis","inlineContent":[{"text":"UnityMacDialogManagerBridge.h \/ .m","type":"text"}]},{"text":") further flatten those into plain C primitives so they can be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"consumed with P\/Invoke ("},{"type":"codeVoice","code":"[DllImport(\"__Internal\")]"},{"type":"text","text":") from Unity C# code. A managed helper ("},{"type":"codeVoice","code":"MacDialogManager"},{"type":"text","text":" C# MonoBehaviour)"},{"type":"text","text":" "},{"type":"text","text":"exposes idiomatic events, performs marshaling, and handles memory cleanup."}],"type":"paragraph"},{"inlineContent":[{"text":"Layering:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["Unity C# (MacDialogManager.cs)","   ↓ (P\/Invoke \/ DllImport)","C Bridge (UnityMacDialogManagerBridge.*)","   ↓ (Objective‑C → Swift)","UnityMacDialogManager (Swift facade)","   ↓","MacDialogManager (Core logic)","   ↓","AppKit (NSAlert \/ NSOpenPanel \/ NSSavePanel)"],"syntax":null},{"anchor":"Result-Dictionaries","level":3,"text":"Result Dictionaries","type":"heading"},{"inlineContent":[{"text":"Each dialog type returns a dictionary with well‑defined keys (all values are Foundation bridged types):","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Dialog Type","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keys","type":"text"}]}]],[[{"inlineContent":[{"text":"Alert","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"buttonTitle:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"buttonIndex:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"suppressionButtonState:Bool","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"File \/ MultiFile \/ Folder \/ MultiFolder","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"filePaths:[String]","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fileCount:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"directoryURL:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isCancelled:Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess:Bool","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Save","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"filePath:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fileCount:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"directoryURL:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isCancelled:Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess:Bool","type":"codeVoice"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"Error cases provide an ","type":"text"},{"code":"NSError","type":"codeVoice"},{"text":" whose ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":" mirrors ","type":"text"},{"code":"MacLibrary\/DialogError","type":"codeVoice"},{"text":" text.","type":"text"}]},{"text":"Cancellation Semantics","type":"heading","anchor":"Cancellation-Semantics","level":3},{"type":"paragraph","inlineContent":[{"text":"Cancellation is reported as ","type":"text"},{"code":"isCancelled == true","type":"codeVoice"},{"text":" while still treating the operation as logically successful (","type":"text"},{"code":"isSuccess == true","type":"codeVoice"},{"text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set ","type":"text"},{"code":"isSuccess == false","type":"codeVoice"},{"text":" and provide an ","type":"text"},{"code":"NSError","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Alert JSON Schema","type":"heading","anchor":"Alert-JSON-Schema","level":3},{"type":"paragraph","inlineContent":[{"code":"buttonsJson","type":"codeVoice"},{"text":" example:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"]},{"type":"paragraph","inlineContent":[{"code":"optionsJson","type":"codeVoice"},{"text":" example:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"]},{"type":"paragraph","inlineContent":[{"code":"alertStyle","type":"codeVoice"},{"text":" accepts: ","type":"text"},{"code":"informational","type":"codeVoice"},{"text":" | ","type":"text"},{"code":"warning","type":"codeVoice"},{"text":" | ","type":"text"},{"code":"critical","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"File & Folder Selection","type":"heading","anchor":"File--Folder-Selection","level":3},{"type":"paragraph","inlineContent":[{"text":"File filters are passed as an array of filename extensions (no leading dot) and converted to ","type":"text"},{"code":"UTType","type":"codeVoice"},{"text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly.","type":"text"}]},{"text":"Save Panel","type":"heading","anchor":"Save-Panel","level":3},{"type":"paragraph","inlineContent":[{"text":"The save dialog returns a single path. ","type":"text"},{"code":"fileCount","type":"codeVoice"},{"text":" remains for structural symmetry (1 on success, 0 if cancelled).","type":"text"}]},{"text":"Threading","type":"heading","anchor":"Threading","level":3},{"type":"paragraph","inlineContent":[{"text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events.","type":"text"}]},{"text":"Memory & Lifetime Notes","type":"heading","anchor":"Memory--Lifetime-Notes","level":3},{"type":"paragraph","inlineContent":[{"text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them (","type":"text"},{"code":"Marshal.PtrToStringUTF8","type":"codeVoice"},{"text":") into managed strings immediately. Caller code only receives safe managed data.","type":"text"}]},{"type":"thematicBreak"},{"text":"Unity C# Wrapper (MacDialogManager.cs)","type":"heading","anchor":"Unity-C-Wrapper-MacDialogManagercs","level":2},{"type":"paragraph","inlineContent":[{"text":"The provided sample ","type":"text"},{"code":"MacDialogManager","type":"codeVoice"},{"text":" MonoBehaviour offers:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Lazy singleton creation (","type":"text"},{"type":"codeVoice","code":"Instance"},{"text":" property); object is marked ","type":"text"},{"type":"codeVoice","code":"DontDestroyOnLoad"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Event-based result delivery for each dialog type:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MultiFileDialogResult(…)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FolderDialogResult(…)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MultiFolderDialogResult(…)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Validation (title, buttons\/options presence) with early error event emission.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Main‑thread dispatch for all event invocations.","type":"text"}]}]}],"type":"unorderedList"},{"text":"C# Alert Usage","type":"heading","anchor":"C-Alert-Usage","level":3},{"type":"codeListing","syntax":"csharp","code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (success) Debug.Log($\"Pressed {title} (index {index}) suppression={suppression}\");","    else Debug.LogError(err);","};","MacDialogManager.Instance.ShowDialog(\"Example\", \"Choose an option\", buttons, options);"]},{"text":"C# Single File Dialog","type":"heading","anchor":"C-Single-File-Dialog","level":3},{"type":"codeListing","syntax":"csharp","code":["MacDialogManager.Instance.FileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (!success) { Debug.LogError(err); return; }","    if (cancelled) Debug.Log(\"User cancelled\"); else Debug.Log(string.Join(\"\\n\", paths));","};","MacDialogManager.Instance.ShowFileDialog(\"Select File\", \"Pick a single file\", new [] { \"txt\", \"md\" });"]},{"text":"C# Multi File Dialog","type":"heading","anchor":"C-Multi-File-Dialog","level":3},{"type":"codeListing","syntax":"csharp","code":["MacDialogManager.Instance.MultiFileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Selected {count} files\");","};","MacDialogManager.Instance.ShowMultiFileDialog(\"Select Files\", \"Choose multiple\", new [] { \"png\", \"jpg\" });"]},{"text":"C# Folder & Multi Folder","type":"heading","anchor":"C-Folder--Multi-Folder","level":3},{"type":"codeListing","syntax":"csharp","code":["MacDialogManager.Instance.FolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folder: {paths?[0]}\");","};","MacDialogManager.Instance.ShowFolderDialog(\"Select Folder\", \"Choose a folder\");","","MacDialogManager.Instance.MultiFolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folders: {string.Join(\", \", paths ?? Array.Empty<string>())}\");","};","MacDialogManager.Instance.ShowMultiFolderDialog(\"Select Folders\", \"Choose multiple folders\");"]},{"text":"C# Save File Dialog","type":"heading","anchor":"C-Save-File-Dialog","level":3},{"type":"codeListing","syntax":"csharp","code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"]},{"text":"Events Lifecycle Notes","type":"heading","anchor":"Events-Lifecycle-Notes","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Subscribe ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"text":" invoking the corresponding ","type":"text"},{"type":"codeVoice","code":"Show*"},{"text":" method to avoid race conditions if a dialog closes quickly (rare but possible).","type":"text"}]}]},{"content":[{"type":"paragr
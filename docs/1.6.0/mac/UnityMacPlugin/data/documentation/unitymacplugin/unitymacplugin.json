{"identifier":{"url":"doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin\/UnityMacPlugin","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"High‑level Unity bridge for macOS dialog presentation built on top of "},{"code":"MacLibrary","type":"codeVoice"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"inlineContent":[{"type":"codeVoice","code":"UnityMacPlugin"},{"text":" exposes the dialog and file panel functionality implemented in the Swift","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"text":" to Unity (C#) or other native layers through a thin","type":"text"},{"text":" ","type":"text"},{"text":"Objective‑C \/ C bridge. It handles:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alert dialogs ("},{"type":"codeVoice","code":"UnityMacDialogManager\/showDialog(title:message:buttonsJson:optionsJson:completion:)"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Single & multi file pickers (open panels)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Single & multi folder pickers","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Save file dialogs"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Suppression checkbox state reporting"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"JSON → Swift option translation for alert configuration","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Safe marshaling of results back to Unity via C function callbacks","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Architecture","anchor":"Architecture","level":3},{"type":"paragraph","inlineContent":[{"code":"UnityMacDialogManager","type":"codeVoice"},{"type":"text","text":" wraps "},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"text":" and converts strongly typed Swift ","type":"text"},{"code":"Result","type":"codeVoice"},{"text":" ","type":"text"},{"text":"completions into Objective‑C friendly ","type":"text"},{"type":"codeVoice","code":"(NSDictionary?, NSError?)"},{"text":" callbacks. The C bridge functions","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"(defined in "},{"type":"emphasis","inlineContent":[{"text":"UnityMacDialogManagerBridge.h \/ .m","type":"text"}]},{"text":") further flatten those into plain C primitives so they can be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"consumed with P\/Invoke ("},{"type":"codeVoice","code":"[DllImport(\"__Internal\")]"},{"type":"text","text":") from Unity C# code. A managed helper ("},{"type":"codeVoice","code":"MacDialogManager"},{"type":"text","text":" C# MonoBehaviour)"},{"type":"text","text":" "},{"text":"exposes idiomatic events, performs marshaling, and handles memory cleanup.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Layering:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["Unity C# (MacDialogManager.cs)","   ↓ (P\/Invoke \/ DllImport)","C Bridge (UnityMacDialogManagerBridge.*)","   ↓ (Objective‑C → Swift)","UnityMacDialogManager (Swift facade)","   ↓","MacDialogManager (Core logic)","   ↓","AppKit (NSAlert \/ NSOpenPanel \/ NSSavePanel)"]},{"level":3,"text":"Result Dictionaries","anchor":"Result-Dictionaries","type":"heading"},{"inlineContent":[{"type":"text","text":"Each dialog type returns a dictionary with well‑defined keys (all values are Foundation bridged types):"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Dialog Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keys"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Alert"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"buttonTitle:String"},{"text":", ","type":"text"},{"code":"buttonIndex:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"suppressionButtonState:Bool","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"File \/ MultiFile \/ Folder \/ MultiFolder"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"filePaths:[String]"},{"type":"text","text":", "},{"type":"codeVoice","code":"fileCount:Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"directoryURL:String"},{"type":"text","text":", "},{"type":"codeVoice","code":"isCancelled:Bool"},{"type":"text","text":", "},{"type":"codeVoice","code":"isSuccess:Bool"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Save","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"filePath:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fileCount:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"directoryURL:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isCancelled:Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess:Bool","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Error cases provide an ","type":"text"},{"code":"NSError","type":"codeVoice"},{"text":" whose ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":" mirrors ","type":"text"},{"code":"MacLibrary\/DialogError","type":"codeVoice"},{"text":" text.","type":"text"}],"type":"paragraph"},{"text":"Cancellation Semantics","anchor":"Cancellation-Semantics","type":"heading","level":3},{"inlineContent":[{"text":"Cancellation is reported as ","type":"text"},{"type":"codeVoice","code":"isCancelled == true"},{"text":" while still treating the operation as logically successful (","type":"text"},{"type":"codeVoice","code":"isSuccess == true"},{"text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set ","type":"text"},{"type":"codeVoice","code":"isSuccess == false"},{"text":" and provide an ","type":"text"},{"type":"codeVoice","code":"NSError"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Alert JSON Schema","anchor":"Alert-JSON-Schema","type":"heading","level":3},{"inlineContent":[{"code":"buttonsJson","type":"codeVoice"},{"text":" example:","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"],"type":"codeListing"},{"inlineContent":[{"code":"optionsJson","type":"codeVoice"},{"type":"text","text":" example:"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"alertStyle"},{"type":"text","text":" accepts: "},{"type":"codeVoice","code":"informational"},{"text":" | ","type":"text"},{"code":"warning","type":"codeVoice"},{"text":" | ","type":"text"},{"code":"critical","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"File--Folder-Selection","type":"heading","level":3,"text":"File & Folder Selection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"File filters are passed as an array of filename extensions (no leading dot) and converted to "},{"type":"codeVoice","code":"UTType"},{"type":"text","text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly."}]},{"anchor":"Save-Panel","type":"heading","level":3,"text":"Save Panel"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The save dialog returns a single path. "},{"code":"fileCount","type":"codeVoice"},{"type":"text","text":" remains for structural symmetry (1 on success, 0 if cancelled)."}]},{"anchor":"Threading","type":"heading","level":3,"text":"Threading"},{"type":"paragraph","inlineContent":[{"text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events.","type":"text"}]},{"anchor":"Memory--Lifetime-Notes","type":"heading","level":3,"text":"Memory & Lifetime Notes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them ("},{"code":"Marshal.PtrToStringUTF8","type":"codeVoice"},{"type":"text","text":") into managed strings immediately. Caller code only receives safe managed data."}]},{"type":"thematicBreak"},{"anchor":"Unity-C-Wrapper-MacDialogManagercs","type":"heading","level":2,"text":"Unity C# Wrapper (MacDialogManager.cs)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The provided sample "},{"type":"codeVoice","code":"MacDialogManager"},{"type":"text","text":" MonoBehaviour offers:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Lazy singleton creation ("},{"type":"codeVoice","code":"Instance"},{"type":"text","text":" property); object is marked "},{"type":"codeVoice","code":"DontDestroyOnLoad"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Event-based result delivery for each dialog type:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MultiFileDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FolderDialogResult(…)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MultiFolderDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"content":[{"inlineContent":[{"type":"text","text":"Validation (title, buttons\/options presence) with early error event emission."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Main‑thread dispatch for all event invocations.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"C-Alert-Usage","type":"heading","level":3,"text":"C# Alert Usage"},{"type":"codeListing","code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (success) Debug.Log($\"Pressed {title} (index {index}) suppression={suppression}\");","    else Debug.LogError(err);","};","MacDialogManager.Instance.ShowDialog(\"Example\", \"Choose an option\", buttons, options);"],"syntax":"csharp"},{"anchor":"C-Single-File-Dialog","type":"heading","level":3,"text":"C# Single File Dialog"},{"type":"codeListing","code":["MacDialogManager.Instance.FileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (!success) { Debug.LogError(err); return; }","    if (cancelled) Debug.Log(\"User cancelled\"); else Debug.Log(string.Join(\"\\n\", paths));","};","MacDialogManager.Instance.ShowFileDialog(\"Select File\", \"Pick a single file\", new [] { \"txt\", \"md\" });"],"syntax":"csharp"},{"text":"C# Multi File Dialog","anchor":"C-Multi-File-Dialog","type":"heading","level":3},{"type":"codeListing","syntax":"csharp","code":["MacDialogManager.Instance.MultiFileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Selected {count} files\");","};","MacDialogManager.Instance.ShowMultiFileDialog(\"Select Files\", \"Choose multiple\", new [] { \"png\", \"jpg\" });"]},{"text":"C# Folder & Multi Folder","anchor":"C-Folder--Multi-Folder","type":"heading","level":3},{"type":"codeListing","syntax":"csharp","code":["MacDialogManager.Instance.FolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folder: {paths?[0]}\");","};","MacDialogManager.Instance.ShowFolderDialog(\"Select Folder\", \"Choose a folder\");","","MacDialogManager.Instance.MultiFolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folders: {string.Join(\", \", paths ?? Array.Empty<string>())}\");","};","MacDialogManager.Instance.ShowMultiFolderDialog(\"Select Folders\", \"Choose multiple folders\");"]},{"text":"C# Save File Dialog","anchor":"C-Save-File-Dialog","type":"heading","level":3},{"type":"codeListing","syntax":"csharp","code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"]},{"text":"Events Lifecycle Notes","anchor":"Events-Lifecycle-Notes","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"text":"Subscribe ","type":"text"},{"type":"strong","inlineContent":[{"text":"before","type":"text"}]},{"text":" invoking the corresponding ","type":"text"},{"code":"Show*","type":"codeVoice"},{"text":" method to avoid race conditions if a dialog closes quickly (rare but possible).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Unsubscribe when no longer needed to avoid memory leaks in long‑running editor sessions.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Multiple listeners are supported; each is invoked sequentially."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"text":"C Bridge Mapping","anchor":"C-Bridge-Mapping","type":"heading","level":2},{"rows":[[[{"inlineContent":[{"type":"text","text":"C Function"}],"type":"paragraph"}],[{"inlineContent":[{"text":"C# DllImport Signature (Simplified)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Managed Invoke Method","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Result Event"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"showDialog"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"void showDialog(string,string,string,string,DialogCallback)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ShowDialog(...)"}],"type":"paragraph"}],[{"inlineContent":[{"code":"AlertDialogResult","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"showFileDialog","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"void showFileDialog(string,string,IntPtr,int,string,FileDialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowFileDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"FileDialogResult"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"showMultiFileDialog"}],"type":"paragraph"}],[{"inlineContent":[{
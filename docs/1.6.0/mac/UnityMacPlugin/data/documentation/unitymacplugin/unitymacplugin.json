"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A contiguous pointer array is allocated and passed to the C bridge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Cleanup occurs inside the callback’s "},{"type":"codeVoice","code":"finally"},{"type":"text","text":" block after the Unity main thread event dispatch, ensuring no premature free."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"On exceptions during setup, allocated buffers are freed before emitting an error event.","type":"text"}]}]}]},{"level":3,"type":"heading","text":"Error Patterns","anchor":"Error-Patterns"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Condition"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Emitted Event Values"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Notes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Empty title"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"buttonIndex \/ fileCount = -1"},{"type":"text","text":", "},{"type":"codeVoice","code":"isSuccess=false"},{"type":"text","text":", error message populated"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Validation short‑circuit"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"No buttons (alert)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"buttonIndex = -1"},{"type":"text","text":", "},{"type":"codeVoice","code":"isSuccess=false"}]}],[{"type":"paragraph","inlineContent":[{"code":"DialogError.noButtons","type":"codeVoice"},{"type":"text","text":" equivalent"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"User cancel (panel)"}]}],[{"type":"paragraph","inlineContent":[{"code":"isCancelled=true","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess=true","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","tex
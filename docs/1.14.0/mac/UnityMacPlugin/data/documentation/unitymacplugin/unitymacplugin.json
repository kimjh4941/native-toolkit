{"sections":[],"hierarchy":{"paths":[["doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin"]]},"variants":[{"paths":["\/documentation\/unitymacplugin\/unitymacplugin"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/unitymacplugin\/unitymacplugin"],"traits":[{"interfaceLanguage":"occ"}]}],"metadata":{"role":"article","modules":[{"name":"UnityMacPlugin"}],"roleHeading":"Article","title":"`UnityMacPlugin`"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"High‑level Unity bridge for macOS dialog presentation built on top of "},{"type":"codeVoice","code":"MacLibrary"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/unity.mac.plugin.UnityMacPlugin\/documentation\/UnityMacPlugin\/UnityMacPlugin","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"UnityMacPlugin","type":"codeVoice"},{"type":"text","text":" exposes the dialog and file panel functionality implemented in the Swift"},{"type":"text","text":" "},{"code":"MacLibrary\/MacDialogManager","type":"codeVoice"},{"type":"text","text":" to Unity (C#) or other native layers through a thin"},{"type":"text","text":" "},{"type":"text","text":"Objective‑C \/ C bridge. It handles:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Alert dialogs (","type":"text"},{"type":"codeVoice","code":"UnityMacDialogManager\/showDialog(title:message:buttonsJson:optionsJson:completion:)"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Single & multi file pickers (open panels)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Single & multi folder pickers","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Save file dialogs","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Suppression checkbox state reporting","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"JSON → Swift option translation for alert configuration"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Safe marshaling of results back to Unity via C function callbacks"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Architecture","type":"heading","level":3,"anchor":"Architecture"},{"type":"paragraph","inlineContent":[{"code":"UnityMacDialogManager","type":"codeVoice"},{"type":"text","text":" wraps "},{"code":"MacLibrary\/MacDialogManager","type":"codeVoice"},{"type":"text","text":" and converts strongly typed Swift "},{"code":"Result","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"completions into Objective‑C friendly "},{"code":"(NSDictionary?, NSError?)","type":"codeVoice"},{"type":"text","text":" callbacks. The C bridge functions"},{"type":"text","text":" "},{"type":"text","text":"(defined in "},{"inlineContent":[{"type":"text","text":"UnityMacDialogManagerBridge.h \/ .m"}],"type":"emphasis"},{"type":"text","text":") further flatten those into plain C primitives so they can be"},{"type":"text","text":" "},{"type":"text","text":"consumed with P\/Invoke ("},{"code":"[DllImport(\"__Internal\")]","type":"codeVoice"},{"type":"text","text":") from Unity C# code. A managed helper ("},{"code":"MacDialogManager","type":"codeVoice"},{"type":"text","text":" C# MonoBehaviour)"},{"type":"text","text":" "},{"type":"text","text":"exposes idiomatic events, performs marshaling, and handles memory cleanup."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layering:"}]},{"type":"codeListing","syntax":null,"code":["Unity C# (MacDialogManager.cs)","   ↓ (P\/Invoke \/ DllImport)","C Bridge (UnityMacDialogManagerBridge.*)","   ↓ (Objective‑C → Swift)","UnityMacDialogManager (Swift facade)","   ↓","MacDialogManager (Core logic)","   ↓","AppKit (NSAlert \/ NSOpenPanel \/ NSSavePanel)"]},{"text":"Result Dictionaries","type":"heading","level":3,"anchor":"Result-Dictionaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each dialog type returns a dictionary with well‑defined keys (all values are Foundation bridged types):"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dialog Type"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alert"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"buttonTitle:String"},{"type":"text","text":", "},{"type":"codeVoice","code":"buttonIndex:Int"},{"type":"text","text":", "},{"code":"suppressionButtonState:Bool","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"File \/ MultiFile \/ Folder \/ MultiFolder","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"filePaths:[String]"},{"type":"text","text":", "},{"type":"codeVoice","code":"fileCount:Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"directoryURL:String"},{"type":"text","text":", "},{"type":"codeVoice","code":"isCancelled:Bool"},{"type":"text","text":", "},{"type":"codeVoice","code":"isSuccess:Bool"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Save"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"filePath:String"},{"type":"text","text":", "},{"type":"codeVoice","code":"fileCount:Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"directoryURL:String"},{"type":"text","text":", "},{"code":"isCancelled:Bool","type":"codeVoice"},{"type":"text","text":", "},{"code":"isSuccess:Bool","type":"codeVoice"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"Error cases provide an ","type":"text"},{"type":"codeVoice","code":"NSError"},{"text":" whose ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" mirrors "},{"code":"MacLibrary\/DialogError","type":"codeVoice"},{"text":" text.","type":"text"}]},{"type":"heading","text":"Cancellation Semantics","level":3,"anchor":"Cancellation-Semantics"},{"type":"paragraph","inlineContent":[{"text":"Cancellation is reported as ","type":"text"},{"type":"codeVoice","code":"isCancelled == true"},{"type":"text","text":" while still treating the operation as logically successful ("},{"type":"codeVoice","code":"isSuccess == true"},{"text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set ","type":"text"},{"type":"codeVoice","code":"isSuccess == false"},{"type":"text","text":" and provide an "},{"code":"NSError","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Alert JSON Schema","level":3,"type":"heading","anchor":"Alert-JSON-Schema"},{"type":"paragraph","inlineContent":[{"code":"buttonsJson","type":"codeVoice"},{"type":"text","text":" example:"}]},{"code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"],"syntax":"json","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"optionsJson","type":"codeVoice"},{"type":"text","text":" example:"}]},{"code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"code":"alertStyle","type":"codeVoice"},{"type":"text","text":" accepts: "},{"code":"informational","type":"codeVoice"},{"type":"text","text":" | "},{"code":"warning","type":"codeVoice"},{"type":"text","text":" | "},{"type":"codeVoice","code":"critical"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"anchor":"File--Folder-Selection","type":"heading","text":"File & Folder Selection"},{"inlineContent":[{"type":"text","text":"File filters are passed as an array of filename extensions (no leading dot) and converted to "},{"code":"UTType","type":"codeVoice"},{"type":"text","text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly."}],"type":"paragraph"},{"level":3,"text":"Save Panel","anchor":"Save-Panel","type":"heading"},{"inlineContent":[{"type":"text","text":"The save dialog returns a single path. "},{"code":"fileCount","type":"codeVoice"},{"type":"text","text":" remains for structural symmetry (1 on success, 0 if cancelled)."}],"type":"paragraph"},{"type":"heading","text":"Threading","level":3,"anchor":"Threading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events."}]},{"type":"heading","level":3,"text":"Memory & Lifetime Notes","anchor":"Memory--Lifetime-Notes"},{"inlineContent":[{"type":"text","text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them ("},{"type":"codeVoice","code":"Marshal.PtrToStringUTF8"},{"type":"text","text":") into managed strings immediately. Caller code only receives safe managed data."}],"type":"paragraph"},{"type":"thematicBreak"},{"type":"heading","text":"Unity C# Wrapper (MacDialogManager.cs)","level":2,"anchor":"Unity-C-Wrapper-MacDialogManagercs"},{"inlineContent":[{"type":"text","text":"The provided sample "},{"type":"codeVoice","code":"MacDialogManager"},{"text":" MonoBehaviour offers:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lazy singleton creation ("},{"type":"codeVoice","code":"Instance"},{"type":"text","text":" property); object is marked "},{"code":"DontDestroyOnLoad","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Event-based result delivery for each dialog type:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MultiFileDialogResult(…)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FolderDialogResult(…)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MultiFolderDialogResult(…)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}],"type":"paragraph"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Validation (title, buttons\/options presence) with early error event emission."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Main‑thread dispatch for all event invocations."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"C# Alert Usage","anchor":"C-Alert-Usage","type":"heading"},{"syntax":"csharp","type":"codeListing","code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (success) Debug.Log($\"Pressed {title} (index {index}) suppression={suppression}\");","    else Debug.LogError(err);","};","MacDialogManager.Instance.ShowDialog(\"Example\", \"Choose an option\", buttons, options);"]},{"type":"heading","text":"C# Single File Dialog","level":3,"anchor":"C-Single-File-Dialog"},{"type":"codeListing","syntax":"csharp","code":["MacDialogManager.Instance.FileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (!success) { Debug.LogError(err); return; }","    if (cancelled) Debug.Log(\"User cancelled\"); else Debug.Log(string.Join(\"\\n\", paths));","};","MacDialogManager.Instance.ShowFileDialog(\"Select File\", \"Pick a single file\", new [] { \"txt\", \"md\" });"]},{"text":"C# Multi File Dialog","level":3,"type":"heading","anchor":"C-Multi-File-Dialog"},{"syntax":"csharp","type":"codeListing","code":["MacDialogManager.Instance.MultiFileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Selected {count} files\");","};","MacDialogManager.Instance.ShowMultiFileDialog(\"Select Files\", \"Choose multiple\", new [] { \"png\", \"jpg\" });"]},{"level":3,"text":"C# Folder & Multi Folder","anchor":"C-Folder--Multi-Folder","type":"heading"},{"syntax":"csharp","type":"codeListing","code":["MacDialogManager.Instance.FolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folder: {paths?[0]}\");","};","MacDialogManager.Instance.ShowFolderDialog(\"Select Folder\", \"Choose a folder\");","","MacDialogManager.Instance.MultiFolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folders: {string.Join(\", \", paths ?? Array.Empty<string>())}\");","};","MacDialogManager.Instance.ShowMultiFolderDialog(\"Select Folders\", \"Choose multiple folders\");"]},{"level":3,"text":"C# Save File Dialog","anchor":"C-Save-File-Dialog","type":"heading"},{"syntax":"csharp","type":"codeListing","code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"]},{"level":3,"text":"Events Lifecycle Notes","anchor":"Events-Lifecycle-Notes","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Subscribe "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"text":" invoking the corresponding ","type":"text"},{"type":"codeVoice","code":"Show*"},{"text":" method to avoid race conditions if a dialog closes quickly (rare but possible).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Unsubscribe when no longer needed to avoid memory leaks in long‑running editor sessions.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Multiple listeners are supported; each is invoked sequentially.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"thematicBreak"},{"anchor":"C-Bridge-Mapping","type":"heading","level":2,"text":"C Bridge Mapping"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"C Function"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"C# DllImport Signature (Simplified)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Managed Invoke Method"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Result Event"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showDialog","type":"codeVoice"}]}],[{"inlineContent":[{"code":"void showDialog(string,string,string,string,DialogCallback)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ShowDialog(...)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"AlertDialogResult","type":"codeVoice"}],
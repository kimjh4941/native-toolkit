,{"inlineContent":[{"code":"share(content:completion:)","type":"codeVoice"},{"type":"text","text":" (picker mode) must be invoked from a user-initiated action"},{"type":"text","text":" "},{"type":"text","text":"(e.g. a button click), since "},{"code":"NSSharingServicePicker.show(...)","type":"codeVoice"},{"type":"text","text":" requires a "},{"code":"mouseDown","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"event context. See "},{"code":"SharePickerPresenter","type":"codeVoice"},{"type":"text","text":" for details."}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"share(content:completion:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"share(content:serviceName:completion:)"},{"type":"text","text":" hop"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"Task { @MainActor in ... }"},{"type":"text","text":" before reaching AppKit. Swift does not guarantee this"},{"type":"text","text":" "},{"type":"text","text":"hop executes synchronously within the "},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" call stack as the caller, even when the"},{"type":"text","text":" "},{"type":"text","text":"caller is already on the main thread inside a real mouseDown-triggered action handler."},{"type":"text","text":" "},{"type":"text","text":"This means the picker-mode call path ("},{"type":"codeVoice","code":"share(content:completion:)"},{"type":"text","text":") may not reliably"},{"type":"text","text":" "},{"type":"text","text":"satisfy "},{"type":"codeVoice","code":"NSSharingServicePicker.show(...)"},{"type":"text","text":"’s mouseDown-context requirement, and this has"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"not been empirically verified against a real user click","type":"text"}]},{"type":"text","text":" (no interactive UI automation"},{"type":"text","text":" "},{"type":"text","text":"was available during implementation\/review). Prefer "},{"type":"codeVoice","code":"shareViaService(content:serviceName:)"},{"type":"text","text":" "},{"type":"text","text":"\/ "},{"type":"codeVoice","code":"share(content:serviceName:completion:)"},{"type":"text","text":" (direct service execution, e.g. "},{"type":"codeVoice","code":".composeEmail"},{"type":"text","text":")"},{"type":"text","text":" "},{"type":"text","text":"as the verified-safe path when reliability matters; treat picker mode as best-effort until"},{"type":"text","text":" "},{"type":"text","text":"manually confirmed on real hardware with a genuine click. See design doc §12 “設計上の分岐”."}],"type":"paragraph"}],"type":"aside"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The native "},{"type":"codeVoice","code":"async throws"},{"type":"text","text":" overload "},{"type":"codeVoice","code":"share(content:) async throws"},{"type":"text","text":" does not add its"},{"type":"text","text":" "},{"type":"text","text":"own "},{"type":"codeVoice","code":"Task {}"},{"type":"text","text":" hop; if a caller already awaits it directly from a synchronous mouseDown"},{"type":"text","text":" "},{"type":"text","text":"handler via structured concurrency (not a detached "},{"type":"codeVoice","code":"Task {}"},{"type":"text","text":"), it is closer to (but still"},{"type":"text","text":" "},{"type":"text","text":"not guaranteed identical to) the original call stack than the callback overload above."}],"type":"paragraph"}],"type":"aside"},{"text":"Example","anchor":"Example","type":"heading","level":2},{"syntax":"swift","code":["MacShareManager.shared.share(","    content: ShareContent(items: [.text(\"Hello\")])",") { isSuccess, completed, serviceName, errorMessage in","    print(isSuccess, completed, serviceName ?? \"\", errorMessage ?? \"\")","}"],"type":"codeListing"}],"kind":"content"}],"references":{"doc://mac.library.MacLibrary.MacL
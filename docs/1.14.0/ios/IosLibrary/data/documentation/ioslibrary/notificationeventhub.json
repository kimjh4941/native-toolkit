{"abstract":[{"text":"The listeners of one kind of notification event, and the events kept while there are none.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NotificationEventHub","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Event","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Event","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"The library’s hubs are ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/IosNotificationManager\/responses","type":"reference","isActive":true},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/IosNotificationManager\/settingsRequests","type":"reference","isActive":true},{"text":"; you cannot create one.","type":"text"}],"type":"paragraph"},{"anchor":"Delivering-and-keeping","text":"Delivering and keeping","level":2,"type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"When"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What the hub does"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"An event arrives and there are listeners"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Calls every listener once, oldest first. A listener removed by an earlier one in the same delivery is not called"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"An event arrives and there is no listener"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keeps it: up to 32 events, in the order they arrived, for the life of the process (never written to disk), duplicates included. Beyond 32 the oldest is dropped (logged)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/NotificationEventHub\/addListener(_:)","isActive":true},{"type":"text","text":" while events are kept"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Hands every kept event to the new listener inside the call, in order, before it returns. If that listener removes itself on the way, the rest go on to the oldest remaining listener (also one added on the way); with none left, they are kept again, in front of any newer ones"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/NotificationEventRegistration\/remove()","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Takes the listener out at once; a second call does nothing"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"So the events that arrived while nobody listened (a cold start, for example) go to the first","type":"text"},{"text":" ","type":"text"},{"text":"listener that is added, once. The existing receivers of ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/IosNotificationManager","type":"reference","isActive":true},{"text":" are not","type":"text"},{"text":" ","type":"text"},{"text":"listeners: they neither take the kept events nor stop the hub from keeping.","type":"text"}],"type":"paragraph"},{"anchor":"Threading","text":"Threading","level":2,"type":"heading"},{"inlineContent":[{"t
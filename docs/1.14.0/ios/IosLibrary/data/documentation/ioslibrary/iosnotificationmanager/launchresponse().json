{"abstract":[{"text":"The response that launched the app, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when there is none (yet).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"launchResponse","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":"(","kind":"text"},{"text":"NotificationError","identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/NotificationError","kind":"typeIdentifier","preciseIdentifier":"s:10IosLibrary17NotificationErrorO"},{"text":") -> ","kind":"text"},{"text":"NotificationResponseEvent","identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/NotificationResponseEvent","kind":"typeIdentifier","preciseIdentifier":"s:10IosLibrary25NotificationResponseEventV"},{"text":"?","kind":"text"}]}]},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"text":"The launch response with ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/NotificationResponseEvent\/isLaunchResponse","type":"reference","isActive":true},{"text":" set, or","type":"text"},{"text":" ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"text":"The launch response is the first response of the process that brings the app to the","type":"text"},{"text":" ","type":"text"},{"text":"foreground (a tap on the body, or an action with the foreground option), when it arrived","type":"text"},{"text":" ","type":"text"},{"text":"before the app first became active and the library handled it. A response the library","type":"text"},{"text":" ","type":"text"},{"text":"forwarded to the previous delegate is never the launch response, nor is a background","type":"text"},{"text":" ","type":"text"},{"text":"action (it is delivered as an ordinary event). The same response is also delivered by","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/IosNotificationManager\/responses","type":"reference","isActive":true},{"text":" with ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/NotificationResponseEvent\/isLaunchResponse","type":"reference","isActive":true},{"text":" set, so handle it in one","type":"text"},{"text":" ","type":"text"},{"text":"place only.","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"When","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Result","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/IosNotificationManager\/installDelegate()"},{"text":" has not installed the delegate in this process","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Throws ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/NotificationError\/delegateNotInstalled"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"The delegate was first installed while the app was already active","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Before the app first becomes active, and before the first response that brings it to the foreground has been handled","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil"},{"text":" for now; it can become the response later","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"After that","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The launch response, or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" for good","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"text":"The response does not tell whether a custom action has the foreground option: the library","type":"text"},{"text":" ","type":"text"},{"text":"decides it from the application state in the main-queue block that delivers the response","type":"text"},{"text":" ","type":"text"},{"text":"(not ","type":"text"},{"code":".background","type":"codeVoice"},{"text":": brings the app to the foreground). On iOS 18.3, when the user opens the","type":"text"},{"text":" ","type":"text"},{"text":"app within about 0.2 seconds after a background action launched it, that action can be","type":"text"},{"text":" ","type":"text"},{"text":"taken for the launch response.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Main actor only.","type":"text"}]}],"type":"aside","style":"note","name":"Note"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/NotificationError\/delegateNotInstalled","isActive":true,"type":"reference"},{"text":" (see the table).","type":"text"}]}],"type":"aside","style":"note","name":"Throws"}],"kind":"content"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary","doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/IosNotificationManager"]]},"metadata":{"title":"launchResponse()","extendedModule":"IosLibrary","symbolKind":"method","modules":[{"name
{"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/s8SendableP","doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ioslibrary\/requestbox"]}],"metadata":{"title":"RequestBox","navigatorTitle":[{"text":"RequestBox","kind":"identifier"}],"symbolKind":"class","modules":[{"name":"IosLibrary"}],"externalID":"s:10IosLibrary10RequestBoxC","roleHeading":"Class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RequestBox","kind":"identifier"}],"role":"symbol"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["iOS"],"tokens":[{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RequestBox"}]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Create a box before you start a request when you need to cancel that request later, and pass","type":"text"},{"text":" ","type":"text"},{"text":"it to the operation; its manager cancels the request through the box. An operation that is","type":"text"},{"text":" ","type":"text"},{"text":"not given a box creates its own.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The operations that take a box, and the manager methods that cancel through it:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Operation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancel"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"IosDialogManager.show(_:presenter:requestBox:completion:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"IosDialogManager.cancel(_:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"IosClipboardManager.loadItem(_:scope:requestBox:completion:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"IosClipboardManager.cancelLoad(_:)","type":"codeVoice"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The request ends when the box closes, and only the first close counts: the user’s answer or","type":"text"},{"text":" ","type":"text"},{"text":"the loaded item, a cancellation, a failure to present, or the system dismissing the presented","type":"text"},{"text":" ","type":"text"},{"text":"UI. Whatever closes it later is ignored, so the operation’s completion is invoked once.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A box belongs to one request. Passing a box that another request already uses makes the","type":"text"},{"text":" ","type":"text"},{"text":"second request fail at once as an invalid request; the first request is not affected.","type":"text"}]},{"text":"Threading","level":2,"type":"heading","anchor":"Threading"},{"type":"paragraph","inlineContent":[{"code":"RequestBox","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/RequestBox\/init()","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/RequestBox\/isClosed","type":"reference","isActive":true},{"text":" can be used on any thread, and","type":"text"},{"text":" ","type":"text"},{"text":"closing never waits for the main thread.","type":"text"}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary"]]},"abstract":[{"text":"One request of an operation that completes once: a box that is closed exactly once.","type":"text"}],"topicSections":[{"anchor":"Initializers","identifiers":["doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/RequestBox\/init()"],"title":"Initializers","generated":true},{"generated":true,"identifiers":["doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/RequestBox\/isClosed"],"title":"Instance Properties","anchor":"Instance-Properties"}],"seeAlsoSections":[{"generated":true,"anchor":"Presentation-and-Cancellation","identifiers":["doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection","doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/FailureDetail"],"title":"Presentation and Cancellation"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/RequestBox"},"references":{"doc://com.jonghyunkim.nativetoolkit.IosLibrary/documentation/IosLibrary/PresenterSelection":{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/documentation\/IosLibrary\/PresenterSelection","role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PresenterSelection"}],"navigatorTitle":[{"kind":"identifier","text":"PresenterSelection"}],"url":"\/documentation\/ioslibrary\/presenterselection","abstract":[{"type":"text","text":"How an operation that shows system UI chooses the view controller to present from."}],"title":"PresenterSelection"},"doc://com.jonghyunkim.nativetoolkit.IosLibrary/s16SendableMetatypeP":{"identifier":"doc:\/\/com.jonghyunkim.nativetoolkit.IosLibrary\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://com.jonghyunkim.nativetoolkit.IosLibrary/documentation/IosLibrary/RequestBox/isClosed":{"abstract":[{"text":"Whether the request has ended (or was cancelled before it started).","type":"text"}],"url":"\/documenta
,string,IntPtr,int,string,MultiFileDialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowMultiFileDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"MultiFileDialogResult","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showFolderDialog","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showFolderDialog(string,string,string,FolderDialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowFolderDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"FolderDialogResult","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showMultiFolderDialog","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showMultiFolderDialog(string,string,string,MultiFolderDialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowMultiFolderDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"MultiFolderDialogResult","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"showSaveFileDialog","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"void showSaveFileDialog(string,string,string,IntPtr,int,string,SaveFileDialogCallback)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"ShowSaveFileDialog(...)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"SaveFileDialogResult","type":"codeVoice"}]}]]],"type":"table"},{"level":3,"type":"heading","anchor":"Memory-Safety-in-C-Wrapper","text":"Memory Safety in C# Wrapper"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"string[] allowedContentTypes"},{"type":"text","text":" element is marshalled as an individual unmanaged UTF‑8 buffer + NULL terminator."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A contiguous pointer array is allocated and passed to the C bridge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cleanup occurs inside the callback’s "},{"type":"codeVoice","code":"finally"},{"type":"text","text":" block after the Unity main thread event dispatch, ensuring no premature free."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"On exceptions during setup, allocated buffers are freed before emitting an error event."}]}]}],"type":"unorderedList"},{"level":3,"type":"heading","anchor":"Error-Patterns","text":"Error Patterns"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Condition","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Emitted Event Values","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Notes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Empty title","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"buttonIndex \/ fileCount = -1"},{"text":", ","type":"text"},{"type":"codeVoice","code":"isSuccess=false"},{"text":", error message populated","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Validation short‑circuit","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"No buttons (alert)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"buttonIndex = -1"},{"text":", ","type":"text"},{"type":"codeVoice","code":"isSuccess=false"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DialogError.noButtons"},{"text":" equivalent","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"User cancel (panel)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"isCancelled=true"},{"text":", ","type":"text"},{"type":"codeVoice","code":"isSuccess=true"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Not an error","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Runtim
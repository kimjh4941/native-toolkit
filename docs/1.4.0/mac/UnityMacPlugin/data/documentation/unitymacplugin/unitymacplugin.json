{"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"High‑level Unity bridge for macOS dialog presentation built on top of "},{"type":"codeVoice","code":"MacLibrary"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"codeVoice","code":"UnityMacPlugin"},{"type":"text","text":" exposes the dialog and file panel functionality implemented in the Swift"},{"type":"text","text":" "},{"type":"codeVoice","code":"MacLibrary\/MacDialogManager"},{"type":"text","text":" to Unity (C#) or other native layers through a thin"},{"type":"text","text":" "},{"type":"text","text":"Objective‑C \/ C bridge. It handles:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alert dialogs ("},{"code":"UnityMacDialogManager\/showDialog(title:message:buttonsJson:optionsJson:completion:)","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single & multi file pickers (open panels)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Single & multi folder pickers"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Save file dialogs"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Suppression checkbox state reporting"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"JSON → Swift option translation for alert configuration"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Safe marshaling of results back to Unity via C function callbacks"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Architecture","type":"heading","text":"Architecture","level":3},{"type":"paragraph","inlineContent":[{"code":"UnityMacDialogManager","type":"codeVoice"},{"type":"text","text":" wraps "},{"code":"MacLibrary\/MacDialogManager","type":"codeVoice"},{"type":"text","text":" and converts strongly typed Swift "},{"code":"Result","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"completions into Objective‑C friendly "},{"type":"codeVoice","code":"(NSDictionary?, NSError?)"},{"type":"text","text":" callbacks. The C bridge functions"},{"type":"text","text":" "},{"type":"text","text":"(defined in "},{"inlineContent":[{"type":"text","text":"UnityMacDialogManagerBridge.h \/ .m"}],"type":"emphasis"},{"type":"text","text":") further flatten those into plain C primitives so they can be"},{"type":"text","text":" "},{"type":"text","text":"consumed with P\/Invoke ("},{"type":"codeVoice","code":"[DllImport(\"__Internal\")]"},{"type":"text","text":") from Unity C# code. A managed helper ("},{"type":"codeVoice","code":"MacDialogManager"},{"type":"text","text":" C# MonoBehaviour)"},{"type":"text","text":" "},{"type":"text","text":"exposes idiomatic events, performs marshaling, and handles memory cleanup."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layering:"}]},{"type":"codeListing","syntax":null,"code":["Unity C# (MacDialogManager.cs)","   ↓ (P\/Invoke \/ DllImport)","C Bridge (UnityMacDialogManagerBridge.*)","   ↓ (Objective‑C → Swift)","UnityMacDialogManager (Swift facade)","   ↓","MacDialogManager (Core logic)","   ↓","AppKit (NSAlert \/ NSOpenPanel \/ NSSavePanel)"]},{"type":"heading","anchor":"Result-Dictionaries","level":3,"text":"Result Dictionaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each dialog type returns a dictionary with well‑defined keys (all values are Foundation bridged types):"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Dialog Type"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keys"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Alert"}]}],[{"type":"paragraph","inlineContent":[{"code":"buttonTitle:String","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"buttonIndex:Int"},{"type":"text","text":", "},{"code":"suppressionButtonState:Bool","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"File \/ MultiFile \/ Folder \/ MultiFolder"}]}],[{"type":"paragraph","inlineContent":[{"code":"filePaths:[String]","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"fileCount:Int"},{"type":"text","text":", "},{"code":"directoryURL:String","type":"codeVoice"},{"type":"text","text":", "},{"code":"isCancelled:Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isSuccess:Bool","type":"codeVoice"}]}]],[[{"inlineContent":[{"type":"text","text":"Save"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"filePath:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"fileCount:Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"directoryURL:String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"isCancelled:Bool","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"isSuccess:Bool"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Error cases provide an "},{"type":"codeVoice","code":"NSError"},{"text":" whose ","type":"text"},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" mirrors "},{"type":"codeVoice","code":"MacLibrary\/DialogError"},{"type":"text","text":" text."}]},{"text":"Cancellation Semantics","anchor":"Cancellation-Semantics","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Cancellation is reported as ","type":"text"},{"type":"codeVoice","code":"isCancelled == true"},{"text":" while still treating the operation as logically successful (","type":"text"},{"code":"isSuccess == true","type":"codeVoice"},{"text":")—it is a user choice, not a failure. Runtime issues (configuration errors, unexpected failures) set ","type":"text"},{"type":"codeVoice","code":"isSuccess == false"},{"type":"text","text":" and provide an "},{"type":"codeVoice","code":"NSError"},{"text":".","type":"text"}]},{"text":"Alert JSON Schema","anchor":"Alert-JSON-Schema","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"buttonsJson"},{"text":" example:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"buttons\": [","    { \"title\": \"OK\", \"isDefault\": true, \"keyEquivalent\": \"\" },","    { \"title\": \"Cancel\" }","  ]","}"]},{"type":"paragraph","inlineContent":[{"code":"optionsJson","type":"codeVoice"},{"type":"text","text":" example:"}]},{"code":["{","  \"alertStyle\": \"warning\",","  \"showsSuppressionButton\": true,","  \"suppressionButtonTitle\": \"Do not show again\"","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"alertStyle"},{"text":" accepts: ","type":"text"},{"type":"codeVoice","code":"informational"},{"text":" | ","type":"text"},{"type":"codeVoice","code":"warning"},{"text":" | ","type":"text"},{"type":"codeVoice","code":"critical"},{"text":".","type":"text"}]},{"text":"File & Folder Selection","anchor":"File--Folder-Selection","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"File filters are passed as an array of filename extensions (no leading dot) and converted to ","type":"text"},{"type":"codeVoice","code":"UTType"},{"text":"s in Swift. Folder dialogs disable file selection flags and invert selection logic accordingly.","type":"text"}]},{"text":"Save Panel","anchor":"Save-Panel","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"The save dialog returns a single path. ","type":"text"},{"type":"codeVoice","code":"fileCount"},{"type":"text","text":" remains for structural symmetry (1 on success, 0 if cancelled)."}]},{"text":"Threading","anchor":"Threading","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"All public functions are safe to call from any thread. UI work is dispatched onto the main queue by the underlying manager. The C# wrapper enqueues callbacks back to Unity’s main thread (via a dispatcher) before firing events."}]},{"text":"Memory & Lifetime Notes","type":"heading","level":3,"anchor":"Memory--Lifetime-Notes"},{"inlineContent":[{"type":"text","text":"C callback string pointers reference autoreleased NSStrings valid only during the execution of the callback. The Unity C# wrapper copies them ("},{"code":"Marshal.PtrToStringUTF8","type":"codeVoice"},{"type":"text","text":") into managed strings immediately. Caller code only receives safe managed data."}],"type":"paragraph"},{"type":"thematicBreak"},{"level":2,"type":"heading","anchor":"Unity-C-Wrapper-MacDialogManagercs","text":"Unity C# Wrapper (MacDialogManager.cs)"},{"inlineContent":[{"type":"text","text":"The provided sample "},{"code":"MacDialogManager","type":"codeVoice"},{"type":"text","text":" MonoBehaviour offers:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lazy singleton creation ("},{"type":"codeVoice","code":"Instance"},{"text":" property); object is marked ","type":"text"},{"type":"codeVoice","code":"DontDestroyOnLoad"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Event-based result delivery for each dialog type:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AlertDialogResult(string? buttonTitle, int buttonIndex, bool suppressionState, bool isSuccess, string? errorMessage)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FileDialogResult(string[]? filePaths, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MultiFileDialogResult(…)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FolderDialogResult(…)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MultiFolderDialogResult(…)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SaveFileDialogResult(string? filePath, int fileCount, string? directoryURL, bool isCancelled, bool isSuccess, string? errorMessage)","type":"codeVoice"}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Validation (title, buttons\/options presence) with early error event emission."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Explicit unmanaged memory allocation & guaranteed release inside callback (even on error) for content type arrays.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Main‑thread dispatch for all event invocations.","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"type":"heading","text":"C# Alert Usage","anchor":"C-Alert-Usage"},{"code":["var buttons = new [] {","    new DialogButton { title = \"OK\", isDefault = true },","    new DialogButton { title = \"Cancel\" }","};","var options = new DialogOptions { alertStyle = \"informational\", showsSuppressionButton = true, suppressionButtonTitle = \"Do not show again\" };","MacDialogManager.Instance.AlertDialogResult += (title, index, suppression, success, err) => {","    if (success) Debug.Log($\"Pressed {title} (index {index}) suppression={suppression}\");","    else Debug.LogError(err);","};","MacDialogManager.Instance.ShowDialog(\"Example\", \"Choose an option\", buttons, options);"],"type":"codeListing","syntax":"csharp"},{"text":"C# Single File Dialog","type":"heading","level":3,"anchor":"C-Single-File-Dialog"},{"code":["MacDialogManager.Instance.FileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (!success) { Debug.LogError(err); return; }","    if (cancelled) Debug.Log(\"User cancelled\"); else Debug.Log(string.Join(\"\\n\", paths));","};","MacDialogManager.Instance.ShowFileDialog(\"Select File\", \"Pick a single file\", new [] { \"txt\", \"md\" });"],"type":"codeListing","syntax":"csharp"},{"text":"C# Multi File Dialog","anchor":"C-Multi-File-Dialog","type":"heading","level":3},{"code":["MacDialogManager.Instance.MultiFileDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Selected {count} files\");","};","MacDialogManager.Instance.ShowMultiFileDialog(\"Select Files\", \"Choose multiple\", new [] { \"png\", \"jpg\" });"],"type":"codeListing","syntax":"csharp"},{"text":"C# Folder & Multi Folder","type":"heading","level":3,"anchor":"C-Folder--Multi-Folder"},{"code":["MacDialogManager.Instance.FolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folder: {paths?[0]}\");","};","MacDialogManager.Instance.ShowFolderDialog(\"Select Folder\", \"Choose a folder\");","","MacDialogManager.Instance.MultiFolderDialogResult += (paths, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Folders: {string.Join(\", \", paths ?? Array.Empty<string>())}\");","};","MacDialogManager.Instance.ShowMultiFolderDialog(\"Select Folders\", \"Choose multiple folders\");"],"type":"codeListing","syntax":"csharp"},{"level":3,"type":"heading","anchor":"C-Save-File-Dialog","text":"C# Save File Dialog"},{"type":"codeListing","syntax":"csharp","code":["MacDialogManager.Instance.SaveFileDialogResult += (path, count, dir, cancelled, success, err) => {","    if (success && !cancelled) Debug.Log($\"Save path: {path}\");","};","MacDialogManager.Instance.ShowSaveFileDialog(\"Save File\", \"Provide a location\", \"sample.txt\", new [] { \"txt\" });"]},{"level":3,"type":"heading","anchor":"Events-Lifecycle-Notes","text":"Events Lifecycle Notes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Subscribe "},{"type":"strong","inlineContent":[{"type":"text","tex
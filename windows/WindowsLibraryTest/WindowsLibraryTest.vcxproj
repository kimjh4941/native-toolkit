  <ItemGroup>
    <ClInclude Include="pch.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!--
    Generate the Windows App SDK C++/WinRT projection headers (winrt/Microsoft.Windows.*.h)
    with the Windows SDK cppwinrt.exe, matching the SDK's prebuilt winrt/base.h version.
    The AppSDK NuGet build integration is intentionally NOT imported here: this test only
    consumes the generated headers and the OS/SDK winrt headers, and pulling the aggregate
    AppSDK package injects auto-initializer sources that clash with MFC (IUnknown ambiguity).
    Windows App SDK 1.7 ships all winmds in a single lib\uap10.0 folder.
  -->
  <Target Name="GenerateWindowsAppSDKProjection"
          BeforeTargets="ClCompile"
          Condition="'$(Platform)'=='x64'"
          Inputs="$(MSBuildProjectFullPath);..\WindowsLibrary\packages\Microsoft.WindowsAppSDK.1.7.250513003\lib\uap10.0\Microsoft.Windows.AppNotifications.winmd"
          Outputs="$(GeneratedFilesDir)winrt\Microsoft.Windows.AppNotifications.h">
    <PropertyGroup>
      <_SdkCppWinRT>$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\cppwinrt.exe</_SdkCppWinRT>
      <_AppSdkLib>$(MSBuildProjectDirectory)\..\WindowsLibrary\packages\Microsoft.WindowsAppSDK.1.7.250513003\lib\uap10.0</_AppSdkLib>
    </PropertyGroup>
    <MakeDir Directories="$(GeneratedFilesDir)" />
    <Message Importance="high" Text="Generating Windows App SDK C++/WinRT projection into $(GeneratedFilesDir)" />
    <Exec Command="&quot;$(_SdkCppWinRT)&quot; -in &quot;$(_AppSdkLib)\Microsoft.Windows.AppNotifications.winmd&quot; -in &quot;$(_AppSdkLib)\Microsoft.Windows.AppNotifications.Builder.winmd&quot; -in &quot;$(_AppSdkLib)\Microsoft.Windows.AppLifecycle.winmd&quot; -ref &quot;$(_AppSdkLib)&quot; -ref $(TargetPlatformVersion) -out &quot;$(GeneratedFilesDir).&quot;" />
  </Target>
  <ImportGroup Label="ExtensionTargets" />
</Project>

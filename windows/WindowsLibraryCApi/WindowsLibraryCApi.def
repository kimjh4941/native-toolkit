; WindowsLibraryCApi.def - the only list of what the C ABI DLL exports (D-5).
; Keep it in the order of the stage 5 design, section 8.2.

LIBRARY

EXPORTS
	; Common: version and error
	ntk_version
	ntk_last_system_code
	; Common: ntk_string
	ntk_string_data
	ntk_string_size
	ntk_string_free
	; Common: ntk_bytes
	ntk_bytes_data
	ntk_bytes_size
	ntk_bytes_free
	; Common: ntk_string_list
	ntk_string_list_count
	ntk_string_list_at
	ntk_string_list_free
	; Dialog (OP-01..OP-06)
	ntk_dialog_show_alert
	ntk_dialog_show_open_file
	ntk_dialog_show_open_files
	ntk_dialog_show_save_file
	ntk_dialog_show_pick_folder
	ntk_dialog_show_pick_folders
	; Notification: runtime (OP-07)
	ntk_notification_runtime_initialize
	ntk_notification_runtime_free
	; Notification: manager (OP-08, OP-09)
	ntk_notification_manager_create
	ntk_notification_manager_set_invoked_handler
	ntk_notification_manager_close
	ntk_notification_manager_free
	; Notification: operations (OP-10..OP-20)
	ntk_notification_show
	ntk_notification_schedule
	ntk_notification_cancel_scheduled
	ntk_notification_update_progress
	ntk_notification_set_badge
	ntk_notification_remove_by_id
	ntk_notification_remove_by_tag
	ntk_notification_remove_all
	ntk_notification_get_all
	ntk_notification_get_setting
	ntk_notification_open_settings
	; Notification: list (output of OP-18)
	ntk_notification_list_count
	ntk_notification_list_id_at
	ntk_notification_list_tag_at
	ntk_notification_list_group_at
	ntk_notification_list_free
	; Notification: activation (argument of ntk_notification_invoked_fn)
	ntk_notification_activation_raw_arguments
	ntk_notification_activation_value_count
	ntk_notification_activation_key_at
	ntk_notification_activation_value_at
	; Notification: content builder
	ntk_notification_content_create
	ntk_notification_content_free
	ntk_notification_content_set_title
	ntk_notification_content_set_body
	ntk_notification_content_set_tag
	ntk_notification_content_set_group
	ntk_notification_content_set_scenario
	ntk_notification_content_set_hero_image
	ntk_notification_content_set_inline_image
	ntk_notification_content_set_app_logo
	ntk_notification_content_set_attribution
	ntk_notification_content_set_duration
	ntk_notification_content_set_audio
	ntk_notification_content_add_button
	ntk_notification_content_add_button_argument
	ntk_notification_content_add_text_input
	ntk_notification_content_add_combo
	ntk_notification_content_add_combo_item
	ntk_notification_content_set_progress
	ntk_notification_content_set_timestamp
	ntk_notification_content_set_expiration
	ntk_notification_content_set_expires_on_reboot

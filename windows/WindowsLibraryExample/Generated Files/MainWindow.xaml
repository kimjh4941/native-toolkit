<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsLibraryExample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsLibraryExample"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WindowsLibraryExample">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <StackPanel 
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Orientation="Vertical"
            Width="600"
            Padding="30"
            Spacing="30">
                <TextBlock x:ConnectionId='2'
                 x:Name="TitleTextBlock"
                 Height="50"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"
                 Text="WindowsDialogManager Example"
                 FontSize="30"
                 TextAlignment="Center"
                 TextWrapping="Wrap"/>
                <Border Background="LightGray" CornerRadius="8" Margin="10">
                    <TextBlock x:ConnectionId='9'
                    x:Name="ResultTextBlock"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Padding="10"
                    Text="Result will be displayed here"
                    TextAlignment="Center"
                    FontSize="24"
                    TextWrapping="Wrap"/>
                </Border>
                <Button x:ConnectionId='3'
                    x:Name="ShowAlertDialogButton"
                    Content="ShowAlertDialog"
                    Style="{StaticResource DialogButtonStyle}"
                                                       />
                <Button x:ConnectionId='4'
                    x:Name="ShowFileDialogButton"
                    Content="ShowFileDialog"
                    Style="{StaticResource DialogButtonStyle}"
                                                      />
                <Button x:ConnectionId='5'
                    x:Name="ShowMultiFileDialogButton"
                    Content="ShowMultiFileDialog"
                    Style="{StaticResource DialogButtonStyle}"
                                                           />
                <Button x:ConnectionId='6'
                    x:Name="ShowFolderDialogButton"
                    Content="ShowFolderDialog"
                    Style="{StaticResource DialogButtonStyle}"
                                                        />
                <Button x:ConnectionId='7'
                    x:Name="ShowMultiFolderDialogButton"
                    Content="ShowMultiFolderDialog"
                    Style="{StaticResource DialogButtonStyle}"
                                                             />
                <Button x:ConnectionId='8'
                    x:Name="ShowSaveFileDialogButton"
                    Content="ShowSaveFileDialog"
                    Style="{StaticResource DialogButtonStyle}"
                                                          />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>


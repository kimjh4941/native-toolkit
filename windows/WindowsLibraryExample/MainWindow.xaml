<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WindowsLibraryExample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsLibraryExample"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WindowsLibraryExample">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Vertical" Spacing="16">
            <Button
                x:Name="ShowAlertDialogButton"
                Content="ShowAlertDialog"
                Width="180"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="ShowAlertDialogButton_Click"/>
            <Button
                x:Name="ShowFileDialogButton"
                Content="ShowFileDialog"
                Width="180"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="ShowFileDialogButton_Click"/>
            <Button
                x:Name="ShowMultiFileDialogButton"
                Content="ShowMultiFileDialog"
                Width="180"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="ShowMultiFileDialogButton_Click"/>
            <Button
                x:Name="ShowSaveFileDialogButton"
                Content="ShowSaveFileDialog"
                Width="180"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="ShowSaveFileDialogButton_Click"/>
            <Button
                x:Name="ShowFolderDialogButton"
                Content="ShowFolderDialog"
                Width="180"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="ShowFolderDialogButton_Click"/>
            <Button
                x:Name="ShowMultiFolderDialogButton"
                Content="ShowMultiFolderDialog"
                Width="180"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Click="ShowMultiFolderDialogButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
  <!--
    Generate the Windows App SDK C++/WinRT projection headers (winrt/Microsoft.Windows.*.h)
    from the AppSDK metadata winmds using the Windows SDK cppwinrt.exe. This matches the
    version of the SDK's prebuilt winrt/base.h so the static_assert version guard passes.
    The package's own RAR-based projection is disabled above because it does not run in this
    MFC/packages.config project (ResolveAssemblyReferences yields no winmd references).
  -->
  <Target Name="GenerateWindowsAppSDKProjection" BeforeTargets="ClCompile" Condition="'$(Platform)'=='x64'" Inputs="$(MSBuildProjectFullPath);packages\Microsoft.WindowsAppSDK.1.7.250513003\lib\uap10.0\Microsoft.Windows.AppNotifications.winmd" Outputs="$(GeneratedFilesDir)winrt\Microsoft.Windows.AppNotifications.h;$(GeneratedFilesDir)winrt\Microsoft.Windows.ApplicationModel.WindowsAppRuntime.h">
    <PropertyGroup>
      <_SdkCppWinRT>$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\cppwinrt.exe</_SdkCppWinRT>
      <!-- Windows App SDK 1.7 ships all winmds (Microsoft.Windows.* and Microsoft.UI.*) in a single lib\uap10.0 folder. -->
      <_AppSdkLib>$(MSBuildProjectDirectory)\packages\Microsoft.WindowsAppSDK.1.7.250513003\lib\uap10.0</_AppSdkLib>
    </PropertyGroup>
    <MakeDir Directories="$(GeneratedFilesDir)" />
    <Message Importance="high" Text="Generating Windows App SDK C++/WinRT projection into $(GeneratedFilesDir)" />
    <Exec Command="&quot;$(_SdkCppWinRT)&quot; -in &quot;$(_AppSdkLib)\Microsoft.Windows.AppNotifications.winmd&quot; -in &quot;$(_AppSdkLib)\Microsoft.Windows.AppNotifications.Builder.winmd&quot; -in &quot;$(_AppSdkLib)\Microsoft.Windows.AppLifecycle.winmd&quot; -in &quot;$(_AppSdkLib)\Microsoft.Windows.ApplicationModel.WindowsAppRuntime.winmd&quot; -ref &quot;$(_AppSdkLib)&quot; -ref $(TargetPlatformVersion) -out &quot;$(GeneratedFilesDir).&quot;" />
  </Target>

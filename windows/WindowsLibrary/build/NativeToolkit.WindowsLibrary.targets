<?xml version="1.0" encoding="utf-8"?>
<!--
  NativeToolkit.WindowsLibrary.targets
  ========================================
  Picks the right flavour of WindowsLibrary.lib and checks the consumer's
  build settings against the ones the library was built with.

  Four flavours are shipped: x64, Debug and Release, each with /MD and /MT.
  A mismatch in the C runtime or the iterator debug level is caught by the
  linker (LNK2038) because MSVC records those in every object; the settings it
  does not record are checked here instead, before the build starts.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <NativeToolkitLibConfiguration Condition="'$(NativeToolkitLibConfiguration)'=='' and '$(Configuration)'=='Debug'">Debug</NativeToolkitLibConfiguration>
    <NativeToolkitLibConfiguration Condition="'$(NativeToolkitLibConfiguration)'==''">Release</NativeToolkitLibConfiguration>
    <NativeToolkitLibraryDir Condition="'$(NativeToolkitLibraryDir)'==''">$(NativeToolkitRoot)lib\$(Platform)\$(NativeToolkitLibConfiguration)-$(NativeToolkitCrt)\</NativeToolkitLibraryDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Link>
      <AdditionalDependencies>$(NativeToolkitLibraryDir)WindowsLibrary.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="NativeToolkitCheckConsumerSettings" BeforeTargets="ClCompile">
    <Error Condition="'$(Platform)'!='x64'"
           Text="NativeToolkit ships x64 only. This project builds for $(Platform); see the windows-architecture topic (D-3) for when other architectures are decided." />
    <Error Condition="!Exists('$(NativeToolkitLibraryDir)WindowsLibrary.lib')"
           Text="WindowsLibrary.lib was not found at $(NativeToolkitLibraryDir). Expected one of the four shipped flavours: $(Platform) x Debug|Release x MD|MT." />
    <Warning Condition="'$(WholeProgramOptimization)'=='true'"
             Text="The shipped library is built without /GL, so link-time code generation cannot inline across it. This is not an error; see D-3." />
  </Target>

</Project>

<?xml version="1.0" encoding="utf-8"?>
<!--
  WindowsLibraryCApiTest: the unit tests of the C ABI (stage 5, 12.1).

  The C ABI's sources are compiled into the test rather than loaded from the
  DLL, so that its internal pieces (the handles, the struct reading rules, the
  callback gate, the conversions) can be tested on their own. The core comes
  in the way it comes into the C ABI DLL: the static WindowsLibrary
  through a ProjectReference, and what it needs at link time through the
  core's consumer props. The core's own tests stay in WindowsLibraryTest.

  ..\WindowsLibrary\src is on the include path for the core's test seams
  only (the *Internal.h headers with ...ForTest and TestAccess), and
  ..\WindowsLibraryTest for the fakes the C++ API's tests already have
  (Support\ClipboardSessionForTest.h). Both come last, so a C ABI header of
  the same name always wins.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{F8AD3D0C-92D6-41B9-8F9A-1FF4BAABD217}</ProjectGuid>
    <RootNamespace>WindowsLibraryCApiTest</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <!-- The C++ API's headers and the libraries the core links against. -->
    <Import Project="..\WindowsLibrary\build\NativeToolkit.WindowsLibrary.props" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/EHsc /utf-8 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(VCInstallDir)Auxiliary\VS\UnitTest\include;..\WindowsLibraryCApi\include;..\WindowsLibraryCApi\src;$(ProjectDir);..\WindowsLibrary\src;..\WindowsLibraryTest;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalLibraryDirectories>$(VCInstallDir)Auxiliary\VS\UnitTest\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_WINDOWS;_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>_WINDOWS;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="Clipboard\CApiClipboardHarness.h" />
    <ClInclude Include="pch.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <!-- The C ABI under test. -->
    <ClCompile Include="..\WindowsLibraryCApi\src\Clipboard\ClipboardCApi.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Clipboard\ClipboardConvert.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Clipboard\ClipboardDeferredCApi.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Clipboard\ClipboardHistoryCApi.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Clipboard\ClipboardItemsCApi.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Common\CallbackGate.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Common\Handles.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Common\LastError.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Common\ReleaseGuard.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Common\Utf8.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Common\Version.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Dialog\DialogCApi.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Dialog\DialogConvert.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Notification\NotificationCApi.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Notification\NotificationContentCApi.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Notification\NotificationConvert.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\WindowsLibraryCApi\src\Notification\NotificationRuntime.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <!-- The tests. The header checks compile on their own: a PCH would hide a missing include. -->
    <ClCompile Include="Clipboard\CApiClipboardHeaderAsC.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
      <TreatWarningAsError>true</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="Clipboard\CApiClipboardDeferredTest.cpp" />
    <ClCompile Include="Clipboard\CApiClipboardHistoryTest.cpp" />
    <ClCompile Include="Clipboard\CApiClipboardItemsTest.cpp" />
    <ClCompile Include="Clipboard\CApiClipboardTest.cpp" />
    <ClCompile Include="Common\CApiCommonTest.cpp" />
    <ClCompile Include="Common\CApiHeadersAsC.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
      <TreatWarningAsError>true</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="Common\CApiHeadersSelfContained.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="Common\CApiLayoutTest.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="Dialog\CApiDialogHeaderAsC.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
      <TreatWarningAsError>true</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="Dialog\CApiDialogTest.cpp" />
    <ClCompile Include="Notification\CApiNotificationHeaderAsC.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <CompileAs>CompileAsC</CompileAs>
      <TreatWarningAsError>true</TreatWarningAsError>
    </ClCompile>
    <ClCompile Include="Notification\CApiNotificationContentTest.cpp" />
    <ClCompile Include="Notification\CApiNotificationTest.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WindowsLibrary\WindowsLibrary.vcxproj">
      <Project>{6b1d8e42-2a77-4c35-9f0e-3c8e5a17b904}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!--
    The core's notification runtime loads the Windows App SDK through the
    bootstrap DLL; copy it next to the test so the notification tests of the
    C ABI find it, as WindowsLibraryTest does.
  -->
  <Target Name="CopyAppSdkBootstrap" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\WindowsLibrary\packages\Microsoft.WindowsAppSDK.1.7.250513003\runtimes\win-x64\native\Microsoft.WindowsAppRuntime.Bootstrap.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

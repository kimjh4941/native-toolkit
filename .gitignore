# Claude Code
.claude/*
!.claude/skills/

# VSCode
.vscode/

# Visual Studio / MSBuild build artifacts
# Debug/, Release/, x64/ and x86/ are NOT listed here on purpose. Without a path
# they match any directory of that name anywhere in the tree, which silently hid
# agent-rules/workflows/release/ and .codex/skills/release/ from git. Every real
# build output is already covered by the .gitignore inside its own project:
#   android/**/.gitignore        /build
#   ios/.gitignore, mac/.gitignore  /Build
#   windows/*/.gitignore         the standard Visual Studio block
.vs/
*.user
*.tlog
*.log

# Windows build script staging (scripts/build_windows_library_dll.ps1)
windows/Build/

# Bundled nuget.exe (local tooling; not committed)
scripts/nuget/nuget.exe

# NuGet packages.config restore output
packages/

# C++/WinRT generated projection headers
Generated Files/
**/WindowsL.*/

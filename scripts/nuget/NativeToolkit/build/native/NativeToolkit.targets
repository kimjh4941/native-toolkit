<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- NuGet package root -->
  <PropertyGroup>
    <WindowsLibraryPackageRoot>$(MSBuildThisFileDirectory)..\..</WindowsLibraryPackageRoot>
    <WindowsLibraryIncludeDir>$(WindowsLibraryPackageRoot)\build\native\include</WindowsLibraryIncludeDir>

    <!-- Platform mapping: win-x64 / win-x86 -->
    <WindowsLibraryRid Condition="'$(Platform)'=='x64'">win-x64</WindowsLibraryRid>
    <WindowsLibraryRid Condition="'$(Platform)'=='Win32'">win-x86</WindowsLibraryRid>

    <WindowsLibraryNativeDir>$(WindowsLibraryPackageRoot)\runtimes\$(WindowsLibraryRid)\native</WindowsLibraryNativeDir>
    <WindowsLibraryDll>$(WindowsLibraryNativeDir)\NativeToolkit.dll</WindowsLibraryDll>
    <WindowsLibraryLib>$(WindowsLibraryNativeDir)\NativeToolkit.lib</WindowsLibraryLib>
  </PropertyGroup>

  <!-- Auto-add include/lib (MSVC) -->
  <ItemDefinitionGroup Condition="'$(PlatformToolset)' != ''">
    <ClCompile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(WindowsLibraryIncludeDir)</AdditionalIncludeDirectories>
    </ClCompile>

    <Link>
      <AdditionalDependencies>NativeToolkit.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>%(AdditionalLibraryDirectories);$(WindowsLibraryNativeDir)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!-- Copy DLL to TargetDir (fallback to OutDir or AppX when it exists) -->
  <PropertyGroup>
    <WindowsLibraryAppxDir>$(OutDir)AppX\</WindowsLibraryAppxDir>

    <!-- Default to TargetPath/TargetDir/OutDir -->
    <WindowsLibraryOutputDir Condition="'$(TargetPath)' == '' And '$(TargetDir)' == '' And '$(OutDir)' != ''">$(OutDir)</WindowsLibraryOutputDir>
    <WindowsLibraryOutputDir Condition="'$(TargetPath)' == '' And '$(TargetDir)' != ''">$(TargetDir)</WindowsLibraryOutputDir>
    <WindowsLibraryOutputDir Condition="'$(TargetPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(TargetPath)'))\</WindowsLibraryOutputDir>

    <!-- Prefer AppX only when it exists -->
    <WindowsLibraryOutputDir Condition="Exists('$(WindowsLibraryAppxDir)')">$(WindowsLibraryAppxDir)</WindowsLibraryOutputDir>
  </PropertyGroup>

  <Target Name="WindowsLibrary_CopyDllToOutput" AfterTargets="Build"
          Condition="Exists('$(WindowsLibraryDll)') And '$(WindowsLibraryOutputDir)' != ''">
    <MakeDir Directories="$(WindowsLibraryOutputDir)" Condition="!Exists('$(WindowsLibraryOutputDir)')" />
    <Copy SourceFiles="$(WindowsLibraryDll)" DestinationFolder="$(WindowsLibraryOutputDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

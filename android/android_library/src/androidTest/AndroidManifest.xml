<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Gives the instrumented tests input focus: since Android 10 only the focused app can
             read the clipboard or receive its change callbacks. -->
        <activity
            android:name="com.jonghyunkim.nativetoolkit.testing.FocusActivity"
            android:exported="false" />
        <!-- Dialog and permission tests (Kotlin API design IT-03 to IT-07): a FragmentActivity,
             and a plain Activity that makes the library start its transparent host. -->
        <activity
            android:name="com.jonghyunkim.nativetoolkit.testing.TestFragmentActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light" />
        <activity
            android:name="com.jonghyunkim.nativetoolkit.testing.PlainActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light" />
        <!-- The 1.x permission helper (IT-23). -->
        <activity
            android:name="com.jonghyunkim.nativetoolkit.testing.HelperActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light" />
    </application>

</manifest>

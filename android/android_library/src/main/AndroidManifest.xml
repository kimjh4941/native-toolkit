<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required on Android 13 and above -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
        This CallStyle implementation is not a real calling app, so FOREGROUND_SERVICE_SPECIAL_USE
        is used here for demonstration purposes.

        If you later switch to a real calling app using phoneCall-type FGS, consider adding:
        <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

        On Android 14/15, the phoneCall-type FGS will be rejected unless the app also satisfies
        real calling app requirements such as MANAGE_OWN_CALLS or the default dialer role.
    -->

    <application>
        <!--
            Initializes the library at app start (Kotlin API design 8.1). Apps that disable Startup
            call LibraryRuntime.ensureInitialized themselves.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.jonghyunkim.nativetoolkit.common.runtime.LibraryInitializer"
                android:value="androidx.startup" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.native_toolkit.share.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/native_toolkit_share_file_paths" />
        </provider>

        <!-- The transparent host for library UI (Kotlin API design 8.3). -->
        <activity
            android:name=".common.presentation.NtkHostActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/NativeToolkit.Theme.Host"
            android:windowSoftInputMode="adjustResize" />

        <!--
            Notification taps, actions and dismissals (Kotlin API design 8.5). The class names are
            compatibility identifiers: scheduled notifications store them, so never move them.
        -->
        <receiver
            android:name=".notification.presentation.event.NotificationEventReceiver"
            android:exported="false" />

        <activity
            android:name=".notification.presentation.event.NotificationLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver
            android:name=".notification.data.repository.ScheduledNotificationReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".notification.data.repository.ScheduledNotificationBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            This service uses specialUse for sample purposes.
            To switch to phoneCall in the future, change android:foregroundServiceType="phoneCall"
            and ensure the app meets real calling app requirements (MANAGE_OWN_CALLS / default dialer role, etc.).
        -->
        <service
            android:name=".notification.presentation.call.CallStyleForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="call_style_notification" />
        </service>

        <!--
            The progress foreground service is an optional API for long-running dataSync-type background tasks.
            Apps using this library should only use it when a persistent notification is truly needed,
            such as for extended downloads or sync operations.
        -->
        <service
            android:name=".notification.presentation.progress.ProgressForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
